---
import "@splidejs/splide/css";
import type { GetStaticPaths } from "astro";
import { getImage, Image, Picture } from "astro:assets";
import "glightbox/dist/css/glightbox.css";
import Slider from "../../components/slider.astro";
import SocialLink from "../../components/socialLink.astro";
import BackgroundMask from "../../components/sponsorsBackgroundMask.astro";
import Title from "../../components/title.astro";
import { getSponsors } from "../../helpers/getSponsors";
import Layout from "../../layouts/Layout.astro";
import SocialLinks from "../../components/socialLinks.astro";

export const getStaticPaths = (async () => {
  const sponsors = await getSponsors();

  return sponsors
    .map((sponsor) => ({
      params: {
        sponsor: sponsor.slug,
      },
      props: { ...sponsor },
    }))
    .filter((sponsor) => sponsor.props.sponsorTier !== "community");
}) satisfies GetStaticPaths;

const {
  companyName,
  description,
  website,
  companyNameLogo,
  carouselImages,
  technologyStack,
  openPositions,
  testimonials,
  linkedin,
  twitter,
  bluesky,
  facebook,
  github,
  instagram,
  medium,
  youtube,
  slug,
} = Astro.props;

const haveOpenPositions = openPositions.length > 0;

const socialList = {
  website,
  linkedin,
  twitter,
  bluesky,
  facebook,
  github,
  instagram,
  medium,
  youtube,
};
const carouselImagesPromise = await Promise.all(
  carouselImages.map(async (image) => {
    return await getImage({ src: image, width: 1000, height: 600 });
  }),
);
---

<Layout havePadding={false}>
  <BackgroundMask bgImageHeight="500px">
    <div class="sponsor-page">
      <div
        class={`company-info ${!haveOpenPositions ? "no-open-positions" : ""}`}
      >
        <Image
          class={`company-logo ${slug}`}
          src={companyNameLogo}
          alt={companyName}
          height={500}
          width={500}
        />

        <SocialLinks
          socialList={Object.entries(socialList || {}).map(
            ([social, link]) => ({
              social,
              link: link || "",
            }),
          )}
        />

        <div class="sponsor-basic-info">
          <div class="who-we-are">
            <h3 class="subtitle">Who We Are</h3>
            <p class="sponsor-description">{description}</p>
          </div>

          {
            technologyStack.length > 0 && (
              <div class="tech-stack">
                <h3 class="subtitle">Our Technology Stack</h3>
                <div class="stack-items">
                  {technologyStack.map((tech) => (
                    <span class="stack-item">{tech}</span>
                  ))}
                </div>
              </div>
            )
          }
        </div>

        {
          carouselImagesPromise.length > 0 && (
            <Slider
              images={carouselImagesPromise.map((image, index) => ({
                src: image.src,
                alt: `${companyName} image ${index + 1}`,
              }))}
            />
          )
        }

        {
          haveOpenPositions && (
            <div class="open-positions">
              <Title title="Open Positions" style="margin-top: 20px;" />
              <div class="positions-wrapper">
                {openPositions.map((position) => (
                  <a
                    target="_blank"
                    href={position.positionLink}
                    class="position-card"
                  >
                    <h3>{position.position}</h3>
                    <p>{position.location}</p>
                  </a>
                ))}
              </div>
            </div>
          )
        }

        {
          testimonials.length > 0 && (
            <div class="testimonials">
              <Title title="Testimonials" style="margin-top: 60px;" />
              <div class="testimonials-container">
                {testimonials.map((testimonial) => (
                  <div class="testimonial-card">
                    <Picture
                      formats={["avif", "webp"]}
                      src={testimonial.image}
                      alt={testimonial.testimonialAuthor}
                      class="testimonial-image"
                    />
                    <div class="testimonial-content">
                      <p class="testimonial-description">
                        {(testimonial.testimonialDescription || "").trim()}
                      </p>
                      <div class="author-info">
                        <strong>{testimonial.testimonialAuthor}</strong>
                        <span>{testimonial.position}</span>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </div>
  </BackgroundMask>
</Layout>

<style lang="scss">
  .company-logo {
    filter: brightness(0) invert(1);
    height: auto;
    width: 40%;
    object-fit: contain;
    margin-bottom: 32px;

    &.teads {
      filter: brightness(1) invert(0);
    }
  }

  .open-positions {
    margin-top: 140px;
  }

  .positions-wrapper {
    width: 60%;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;

    .position-card {
      width: calc(50% - 30px);
      margin-bottom: 40px;

      p {
        font-weight: 600;
        font-size: 14px;
        margin-top: 12px;
      }
    }
  }
  .sponsor-basic-info {
    width: 60%;
    margin-bottom: 60px;

    h3 {
      margin-bottom: 6px;
    }

    .stack-items {
      display: flex;
      flex-wrap: wrap;

      .stack-item {
        font-weight: 400;
        font-size: 14px;
        --gap: 6px;
        margin-right: var(--gap);
        position: relative;
        display: flex;
        &:not(:last-child)::after {
          content: "•";
          line-height: 100%;
          font-size: 1.2rem;
          margin-left: calc(var(--gap) * 2);
        }
      }
    }
  }

  .sponsor-basic-info + .open-positions {
    margin-top: 80px;
  }

  .sponsor-page {
    color: #f3f3f3;

    .company-info {
      &.no-open-positions {
        .testimonials {
          margin-top: 140px;
        }
      }
    }
  }

  .who-we-are {
    .subtitle {
      margin-top: 0;
    }
  }

  .subtitle {
    font-size: 1.2rem;
    font-weight: 600;
    margin-top: 24px;
  }

  .sponsor-description {
    white-space: pre-wrap;
    font-weight: 400;
    font-size: 14px;
  }

  .testimonials-container {
    display: flex;
    flex-direction: column;
    gap: 60px;

    .testimonial-card {
      display: flex;
      gap: 16px;

      .testimonial-image {
        border-radius: 24px 0 0 0;
        height: 142px;
        width: 100px;
        object-fit: cover;
        object-position: center;
      }

      .testimonial-content {
        font-size: 14px;
        font-weight: 400;
        display: flex;
        flex-direction: column;
        padding: 4px 0;

        .testimonial-description {
          white-space: pre-wrap;

          &::before {
            content: "\201C"; /* “ */
          }
          &::after {
            content: "\201D"; /* ” */
          }
        }

        .author-info {
          margin-top: 24px;
          display: flex;
          flex-direction: column;
          gap: 4px;
        }
      }
    }
  }

  @media screen and (max-width: 768px) {
    .sponsor-basic-info,
    .positions-wrapper {
      width: 100%;
    }

    .company-logo {
      width: 100%;
    }
  }

  @media screen and (max-width: 576px) {
    .positions-wrapper .position-card {
      width: 100%;
    }
  }
</style>
