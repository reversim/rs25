---
import Layout from "../../layouts/Layout.astro";
import { getSessions } from "../../helpers/getSessions";
import slug from "slug";

const sessions = await getSessions();
const sessionsList = sessions.rawSessionsList;

function getTalkInfo(fullText: string): {
  shouldLoadMore: boolean;
  text: string;
  shouldDisplay: boolean;
} {
  const maxLength = 150;

  if (!fullText) {
    return { shouldDisplay: false, shouldLoadMore: false, text: "" };
  }

  if (fullText?.length <= maxLength) {
    return { shouldLoadMore: false, text: fullText, shouldDisplay: true };
  }
  const truncatedText = fullText?.slice(0, maxLength) + "...";
  return { text: truncatedText, shouldLoadMore: true, shouldDisplay: true };
}
---

<Layout>
  <h2>Our Sessions</h2>

  <div class="sessions-container">
    {
      sessionsList.map((session) => {
        const descriptionInfo = getTalkInfo(session.description);
        if (descriptionInfo.shouldDisplay) {
          return (
            <div class="card">
              {!session.isPlenumSession ? (
                <a href={`/session/${slug(session.title)}`} class="session-link">
                  <h4>{session.title}</h4>
                </a>
              ) : (
                <h4>{session.title}</h4>
              )}
              <p class="session-description">
                {descriptionInfo.text}
                {descriptionInfo.shouldLoadMore && (
                  <a href={`/session/${slug(session.title)}`} class="session-link">
                    Read More
                  </a>
                )}
              </p>
            </div>
          );
        }
      })
    }
  </div>
</Layout>

<style lang="scss">
  .card {
    padding: 20px;
    margin-top: 24px;
    border-radius: 5px;

    h4 {
      font-size: 16px;
    }

    .session-description {
      margin-top: 8px;
      font-size: 14px;

      .session-link {
        color: rgb(88, 108, 142);
        margin-left: 5px;
        font-size: 0.9em;
        cursor: pointer;

        &:hover {
          text-decoration: underline;
        }
      }
    }
  }
</style>
