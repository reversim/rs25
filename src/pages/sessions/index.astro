---
import Layout from "../../layouts/Layout.astro";
import { getSessions } from "../../helpers/data/getSessions";
import { getSpeakers } from "../../helpers/data/getSpeakers";
import { getTrackName } from "../../helpers/data/getAgenda";
import FilterTabs from "../../components/shared/filterTabs.astro";
import PageTitle from "../../components/shared/pageTitle.astro";
import SessionCard from "../../components/sessions/sessionCard.astro";
import type { AgendaSpeaker } from "../../types/agenda";
import slug from "slug";
import { event } from "../../config/event";

const [sessions, speakers] = await Promise.all([getSessions(), getSpeakers()]);
const speakersMap = new Map(
  speakers.map((speaker) => [String(speaker.id), speaker]),
);

const sessionsList = sessions.rawSessionsList.filter(
  (session) => session.description,
);
---

<Layout havePaddingBottom={true}>
  <PageTitle
    eyebrow="The lineup"
    title="Our Sessions"
    description="Two days of deep engineering talks from Israel's dev community, covering everything from autonomous and agentic systems to the infrastructure, tools and practices that power them. Browse the full lineup below and filter by day to plan your schedule."
  />

  <FilterTabs
    id="sessions-day-filter"
    attr="day"
    targetSelector=".session-card"
    sticky={true}
    options={event.days.options}
  />

  <div class="sessions-container">
    {
      sessionsList.map((session) => {
        const resolvedSpeakers = session.speakers
          .map((speaker) => speakersMap.get(speaker.id))
          .filter((speaker): speaker is AgendaSpeaker => speaker !== undefined);

        return (
          <SessionCard
            title={session.title}
            description={session.description}
            href={`/session/${slug(session.title)}`}
            speakers={resolvedSpeakers}
            day={session.day}
            track={getTrackName(session)}
          />
        );
      })
    }
  </div>
</Layout>

<style lang="scss">
  .sessions-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
</style>
