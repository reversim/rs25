---
import type { GetStaticPaths } from "astro";
import dayjs from "dayjs";
import slug from "slug";
import Arrow from "../../assets/agenda/arrow.svg";
import SessionCategory from "../../components/agenda/category.astro";
import SessionSpeakers from "../../components/agenda/sessionSpeakers.astro";
import Button from "../../components/shared/button.astro";
import { getTalkCategoryColor } from "../../helpers/agenda/agendaHelpers";
import { getTrackName } from "../../helpers/data/getAgenda";
import { getSessions } from "../../helpers/data/getSessions";
import { getSpeakerById } from "../../helpers/data/getSpeakers";
import type { AgendaSpeaker } from "../../types/agenda";
import type { Talk } from "../../types/session";
import Layout from "../../layouts/Layout.astro";
import {
  SITE_NAME,
  excerpt,
  joinNames,
  ogCardPath,
  withDirectionMark,
} from "../../helpers/meta";

export const getStaticPaths = (async () => {
  async function getPrevAndNextOfTrack(sessions: Talk[], session: Talk) {
    const track = getTrackName(session);

    const sessionsOfTrack = sessions.filter(
      (trackSession: Talk) =>
        getTrackName(trackSession) === track &&
        dayjs(trackSession.startsAt).isSame(dayjs(session.startsAt), "day"),
    );

    const index = sessionsOfTrack.findIndex(
      (trackSession: Talk) => session.id === trackSession.id,
    );
    const prev = sessionsOfTrack[index - 1];
    const next = sessionsOfTrack[index + 1];

    return { prev, next };
  }

  const sessions = await getSessions();

  return Promise.all(
    sessions.rawSessionsList.map(async (session) => {
      const speakers: AgendaSpeaker[] = await Promise.all(
        session.speakers.map(async (speaker) => {
          return await getSpeakerById(speaker.id);
        }),
      );
      const prevAndNext = await getPrevAndNextOfTrack(
        sessions.rawSessionsList,
        session,
      );

      return {
        params: {
          session: slug(session.title),
        },
        props: {
          session: {
            ...session,
            speakers,
          },
          ...prevAndNext,
        },
      };
    }),
  );
}) satisfies GetStaticPaths;

const { session, prev, next } = Astro.props;

const {
  title,
  description,
  room,
  speakers,
  startsAt,
  endsAt,
  categories,
  id,
  recordingUrl,
  day,
} = session;

function getDaySuffix(day: number) {
  if (day >= 11 && day <= 13) {
    return "th";
  }
  switch (day % 10) {
    case 1:
      return "st";
    case 2:
      return "nd";
    case 3:
      return "rd";
    default:
      return "th";
  }
}

function getSessionDate() {
  const startAtDate = dayjs(startsAt);
  const endAtDate = dayjs(endsAt);

  // Format the output
  const day = startAtDate.format("ddd"); // Short day name (e.g., Mon, Tue)
  const startTime = startAtDate.format("H:mm"); // Hour and minute (e.g., 9:00)
  const endTime = endAtDate.format("H:mm"); // Hour and minute (e.g., 9:30)
  const month = startAtDate.format("MMM"); // Get abbreviated month (Mar, Jan, etc.)
  const dayInMonth = startAtDate.date(); // Get the day of the month

  return `${day}, ${month} ${dayInMonth}${getDaySuffix(dayInMonth)}, ${startTime} - ${endTime}`;
}

const categoryColor = getTalkCategoryColor(session);
const track = getTrackName(session);

// Link preview: no start times, as the schedule's hours aren't final yet.
const speakerNames = joinNames(
  speakers.map((speaker) => speaker.fullName || speaker.name || ""),
);
const shareTitle = [withDirectionMark(title), speakerNames]
  .filter(Boolean)
  .join(" | ");
const shareDescription = [
  [speakerNames, `${SITE_NAME}, Day ${day}`].filter(Boolean).join(" · "),
  withDirectionMark(excerpt(description)),
]
  .filter(Boolean)
  .join(". ");
---

<Layout
  share={{
    title: shareTitle,
    description: shareDescription,
    image: {
      path: ogCardPath("session", Astro.params.session),
      alt: [title, speakerNames].filter(Boolean).join(" by "),
    },
  }}
>
  <Button variant="back" text="Sessions" href="/sessions" />
  <div class="session-container">
    <h2>{title}</h2>
    <p class="description">{description}</p>

    <!-- TODO: add this when we have the time zone data -->
    <!-- <div class="session-track-navigator">
      <SessionCategory track={track} categoryColor={categoryColor} />

      <div class="session-actions">
        <button disabled={!prev} class="track-navigator prev">
          {
            prev ? (
              <a href={`/session/${slug(prev.title)}`}>
                <Arrow class="arrow" />
              </a>
            ) : null
          }
        </button>
        <button disabled={!next} class="track-navigator next">
          {
            next ? (
              <a href={`/session/${slug(next.title)}`}>
                <Arrow class="arrow" />
              </a>
            ) : null
          }
        </button>
      </div>
    </div> -->
    <div class="session-information">
      <!-- TODO - return time & room when we have the data -->
      <!-- <h4>Time & Room</h4>
      <p>{getSessionDate()} <span class="separator">•</span> Room: {room}</p> -->

      <h4 class="speakers-title">Speakers</h4>

      <SessionSpeakers speakers={speakers} variant="session-page" />
    </div>
  </div>
</Layout>

<style lang="scss" define:vars={{ categoryColor }}>
  .session-container {
    margin: 16px 0 32px;
    padding: 24px;
    border-radius: var(--rs26-r-md);
    box-shadow: 0 24px 40px -30px rgba(0, 0, 0, 0.8);
    background-color: var(--rs26-panel-2);
    border: 1px solid var(--rs26-navy-line);
  }
  // Long unbroken strings (URLs, code identifiers) would otherwise push the
  // card wider than the viewport on mobile.
  h2,
  .description {
    overflow-wrap: anywhere;
  }

  h2 {
    text-align: start;
    margin-top: 24px;
    color: var(--rs26-white);
  }

  .description {
    line-height: 1.8;
    white-space: pre-wrap;
    color: var(--rs26-text);
  }

  .session-track-navigator {
    display: flex;
    justify-content: space-between;
    align-items: center;

    .session-actions {
      display: flex;
      .track-navigator {
        background: none;
        border: none;
        cursor: pointer;
        color: var(--categoryColor);

        &.prev {
          -webkit-transform: scaleX(-1);
          transform: scaleX(-1);
        }

        > a {
          --gap: 12px;
          padding: var(--gap);
          margin-right: calc(var(--gap) * -1);
        }

        svg {
          height: 14px;
          width: 14px;
        }
        &:hover {
          filter: brightness(0.7);
        }
      }
    }
  }

  .session-information {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--rs26-navy-line);

    h4 {
      margin-bottom: 4px;
      font-family: var(--rs26-mono);
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      font-size: 13px;
      color: var(--rs26-muted);
      &.speakers-title {
        margin-top: 24px;
      }
    }

    a:hover {
      text-decoration: underline;
    }

    .separator {
      font-size: 18px;
    }
  }
</style>
