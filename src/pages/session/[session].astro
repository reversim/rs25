---
import type { GetStaticPaths } from "astro";
import dayjs from "dayjs";
import slug from "slug";
import Arrow from "../../assets/agenda/arrow.svg";
import SessionCategory from "../../components/agenda/category.astro";
import SessionSpeakers from "../../components/agenda/sessionSpeakers.astro";
import BackButton from "../../components/backButton.astro";
import { getTalkCategoryColor } from "../../helpers/agendaHelpers";
import { getTrackName } from "../../helpers/getAgenda";
import { getSessions, type talk } from "../../helpers/getSessions";
import Layout from "../../layouts/Layout.astro";

export const getStaticPaths = (async () => {
  async function getPrevAndNextOfTrack(sessions: talk[], session: talk) {
    const track = getTrackName(session);

    const sessionsOfTrack = sessions.filter(
      (trackSession: talk) =>
        getTrackName(trackSession) === track &&
        dayjs(trackSession.startsAt).isSame(dayjs(session.startsAt), "day"),
    );

    const index = sessionsOfTrack.findIndex(
      (trackSession: talk) => session.id === trackSession.id,
    );
    const prev = sessionsOfTrack[index - 1];
    const next = sessionsOfTrack[index + 1];

    return { prev, next };
  }

  const sessions = await getSessions();

  return Promise.all(
    sessions.rawSessionsList.map(async (session) => {
      const prevAndNext = await getPrevAndNextOfTrack(
        sessions.rawSessionsList,
        session,
      );

      return {
        params: {
          session: slug(session.title),
        },
        props: {
          session,
          ...prevAndNext,
        },
      };
    }),
  );
}) satisfies GetStaticPaths;

const { session, prev, next } = Astro.props;

const {
  title,
  description,
  room,
  speakers,
  startsAt,
  endsAt,
  categories,
  id,
  recordingUrl,
} = session;

function getDaySuffix(day: number) {
  if (day >= 11 && day <= 13) {
    return "th";
  }
  switch (day % 10) {
    case 1:
      return "st";
    case 2:
      return "nd";
    case 3:
      return "rd";
    default:
      return "th";
  }
}

function getSessionDate() {
  const startAtDate = dayjs(startsAt);
  const endAtDate = dayjs(endsAt);

  // Format the output
  const day = startAtDate.format("ddd"); // Short day name (e.g., Mon, Tue)
  const startTime = startAtDate.format("H:mm"); // Hour and minute (e.g., 9:00)
  const endTime = endAtDate.format("H:mm"); // Hour and minute (e.g., 9:30)
  const month = startAtDate.format("MMM"); // Get abbreviated month (Mar, Jan, etc.)
  const dayInMonth = startAtDate.date(); // Get the day of the month

  return `${day}, ${month} ${dayInMonth}${getDaySuffix(dayInMonth)}, ${startTime} - ${endTime}`;
}

const categoryColor = getTalkCategoryColor(session);
const track = getTrackName(session);
---

<Layout>
  <BackButton backToText="Agenda" href="/agenda" />
  <div class="session-container">
    <h2>{title}</h2>
    <p class="description">{description}</p>

    <div class="session-track-navigator">
      <SessionCategory track={track} categoryColor={categoryColor} />

      <div class="session-actions">
        <button disabled={!prev} class="track-navigator prev">
          {
            prev ? (
              <a href={`/session/${slug(prev.title)}`}>
                <Arrow class="arrow" />
              </a>
            ) : null
          }
        </button>
        <button disabled={!next} class="track-navigator next">
          {
            next ? (
              <a href={`/session/${slug(next.title)}`}>
                <Arrow class="arrow" />
              </a>
            ) : null
          }
        </button>
      </div>
    </div>
    <div class="session-information">
      <h4>Time & Room</h4>
      <p>{getSessionDate()} <span class="separator">•</span> Room: {room}</p>

      <h4 class="speakers-title">Speakers</h4>

      <SessionSpeakers speakers={speakers} variant="session-page" />
    </div>
  </div>
</Layout>

<style lang="scss" define:vars={{ categoryColor }}>
  .session-container {
    margin: 16px 0 24px;
    padding: 24px;
    border-radius: 8px;
    box-shadow: 2px 2px 6px lightgray;
    background-color: white;
  }
  h2 {
    text-align: start;
    margin-top: 24px;
    font-weight: 200;
  }

  .description {
    line-height: 2;
    white-space: pre-wrap;
  }

  .session-track-navigator {
    display: flex;
    justify-content: space-between;
    align-items: center;

    .session-actions {
      display: flex;
      gap: 24px;
      .track-navigator {
        background: none;
        border: none;
        cursor: pointer;
        color: var(--categoryColor);

        &.prev {
          -webkit-transform: scaleX(-1);
          transform: scaleX(-1);
        }

        svg {
          height: 14px;
          width: max-content;
        }
        &:hover {
          filter: brightness(0.7);
        }
      }
    }
  }

  .session-information {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid lightgray;

    h4 {
      margin-bottom: 4px;
      font-weight: 400;
      font-size: 14px;
      color: var(--gray);
      &.speakers-title {
        margin-top: 24px;
      }
    }

    a:hover {
      text-decoration: underline;
    }

    .separator {
      font-size: 18px;
    }
  }
</style>
