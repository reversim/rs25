---
import Layout from "../../layouts/Layout.astro";
import {
  getAgendaDays,
  buildDayGrid,
  type AgendaDay,
  type AgendaSession,
  getTrackName,
} from "../../helpers/getAgenda";
import {
  getTalkCategoryColor,
  getTalkUrl,
  createTalkUrl,
  createSlug,
} from "../../helpers/agendaHelpers";
import { createSpeakerUrl } from "../../helpers/agendaHelpers";

// Get the day parameter from the URL
const { day } = Astro.params;

// Get agenda data from Sessionize
const rawAgendaDays = await getAgendaDays();
export async function getStaticPaths() {
  const agendaDays = await getAgendaDays();
  return agendaDays.map((day) => ({
    params: { day: day.slug },
  }));
}

// Process agenda data with grid structure
const agendaDays = rawAgendaDays.map((day) => ({
  ...day,
  grid: buildDayGrid(day),
}));

// Find the requested day or default to first day
let currentDay;
let currentDayIndex = 0;

if (day) {
  // Look for day by slug (yyyy-mm-dd format)
  const dayIndex = agendaDays.findIndex((d) => d.slug === day);
  if (dayIndex !== -1) {
    currentDay = agendaDays[dayIndex];
    currentDayIndex = dayIndex;
  } else {
    // Invalid day, redirect to first day
    return Astro.redirect(`/agenda/${agendaDays[0].slug}`);
  }
} else {
  // No day specified, use first day
  currentDay = agendaDays[0];
  currentDayIndex = 0;
}

// Extract all sessions for filtering (from current day only)
const allSessions: AgendaSession[] = [];
currentDay.rooms.forEach((room) => {
  room.sessions.forEach((session) => {
    allSessions.push(session);
  });
});

// Define the visible room names and their order for the 3-column layout
const desiredRooms = ["Main hall", "Room 2", "Room 3"];
// Extract unique rooms and categories for filters
const uniqueRooms = [
  ...new Set(currentDay.rooms.map((room) => room.name)),
].sort();
const uniqueCategories = [
  ...new Set(
    allSessions.flatMap((session) => {
      const track = getTrackName(session);
      return track ? [track] : [];
    }),
  ),
].sort();
---

<Layout havePadding={false}>
  <div class="agenda-container">
    <div class="agenda-header">
      <h2>Conference Agenda</h2>
      <!-- TODO - add scroll to now button -->
      <!-- <div class="header-actions">
        <button id="scroll-to-now" class="current-time-btn">
          What's there now?
        </button>
      </div> -->
    </div>

    <!-- Liked talks section (initially hidden) -->
    <div id="liked-section" class="liked-section" style="display: none;">
      <div id="liked-talks" class="liked-talks-container"></div>
    </div>

    <!-- Day switcher -->
    <div class="day-switcher">
      {
        agendaDays.map((day, dayIndex) => (
          <a
            href={`/agenda/${day.slug}`}
            class={`day-switch-btn ${dayIndex === currentDayIndex ? "active" : ""}`}
          >
            {day.label}
          </a>
        ))
      }
    </div>

    <!-- TODO Filter Toggle Button -->
    <!-- <div class="filter-toggle-container">
      <button class="filter-toggle-btn" onclick="toggleFilters()">
        <span class="filter-icon">🔍</span>
        Filters
        <span class="filter-arrow">▼</span>
      </button>
    </div> -->

    <!-- Filter Section -->
    <div class="filter-section" id="filter-section" style="display: none;">
      <div class="filter-grid">
        <div class="filter-column">
          <h4>Theme</h4>
          <div class="filter-options" id="theme-filters">
            {
              uniqueCategories.map((category) => (
                <label class="filter-checkbox">
                  <input
                    type="checkbox"
                    value={category}
                    onchange="applyFilters()"
                  />
                  <span class="checkmark" />
                  {category}
                </label>
              ))
            }
          </div>
        </div>

        <div class="filter-column">
          <h4>Rooms</h4>
          <div class="filter-options" id="room-filters">
            {
              uniqueRooms.map((room) => (
                <label class="filter-checkbox">
                  <input
                    type="checkbox"
                    value={room}
                    onchange="applyFilters()"
                  />
                  <span class="checkmark" />
                  {room}
                </label>
              ))
            }
          </div>
        </div>
      </div>

      <div class="filter-footer">
        <button class="reset-filters-btn" onclick="clearAllFilters()"
          >Reset</button
        >
      </div>
    </div>

    <!-- Desktop Grid-based Schedule View -->
    <div class="agenda-grid-container desktop-only">
      <div class="day-schedule active">
        <div class="schedule-header">{currentDay.label}</div>
        <div class="grid-wrapper">
          <div
            class="agenda-grid"
            role="grid"
            aria-label={`Agenda for ${currentDay.label}`}
          >
            <!-- Grid Header -->
            <div class="grid-header">
              <div class="time-column-header">Time</div>
              {
                desiredRooms.map((roomName) => (
                  <div class="room-column-header">{roomName}</div>
                ))
              }
            </div>

            <!-- Grid Body -->
            <div class="grid-body">
              {
                currentDay.grid.map((row, rowIndex) => {
                  // Check if this row has a full-width session
                  const fullWidthSession = row.cells.find(
                    (cell) =>
                      cell.session &&
                      !cell.hidden &&
                      (cell.session.isServiceSession ||
                        cell.session.isPlenumSession ||
                        (cell.span && cell.span >= desiredRooms.length)),
                  );

                  if (fullWidthSession && fullWidthSession.session) {
                    const session = fullWidthSession.session;

                    const duration = Math.round(
                      (new Date(session.endsAt).getTime() -
                        new Date(session.startsAt).getTime()) /
                        (1000 * 60),
                    );

                    return (
                      <div
                        class="time-slot-row full-width-row"
                        id={`time-slot-${currentDay.slug}-${rowIndex}`}
                      >
                        <div class="time-column">
                          <div class="time-display">
                            <div class="start-time">
                              {new Date(row.startsAt).toLocaleTimeString(
                                "en-US",
                                {
                                  hour12: false,
                                  hour: "2-digit",
                                  minute: "2-digit",
                                },
                              )}
                            </div>
                            <div class="end-time">
                              {new Date(row.endsAt).toLocaleTimeString(
                                "en-US",
                                {
                                  hour12: false,
                                  hour: "2-digit",
                                  minute: "2-digit",
                                },
                              )}
                            </div>
                          </div>
                        </div>
                        <div
                          class="break-session-cell"
                          style="grid-column: 2 / -1;"
                          data-talk-id={session.id}
                        >
                          <div
                            class={`break-session-content ${session.room === "Dining Hall" ? "highlighted" : "session-content"}`}
                          >
                            <div class="break-time">{duration} minutes</div>
                            <div
                              class="session-category-indicator"
                              style={`background-color: ${getTalkCategoryColor(session)}`}
                            />
                            {session.isLightningGroup ? (
                              <>
                                <h3 class="break-title">Lightning Talks</h3>
                                <div class="break-location">
                                  {session?.lightningChildren?.[0]?.room}
                                </div>

                                <div class="lightning-talk-list">
                                  {session.lightningChildren?.map(
                                    (child: any) => {
                                      return (
                                        <div class="lightning-talk-container">
                                          <a
                                            class="lightning-talk-title"
                                            href={getTalkUrl(child)}
                                          >
                                            {child.title}
                                          </a>
                                          {child.speakers.length > 0 &&
                                            child.speakers.map(
                                              (speaker: any) => (
                                                <a
                                                  class="lightning-speaker"
                                                  href={createSpeakerUrl(
                                                    speaker.name,
                                                  )}
                                                >
                                                  {speaker.name}
                                                </a>
                                              ),
                                            )}
                                        </div>
                                      );
                                    },
                                  )}
                                </div>
                              </>
                            ) : (
                              <>
                                <h3 class="break-title">{session.title}</h3>
                                <div class="break-location">{session.room}</div>
                              </>
                            )}
                          </div>
                        </div>
                      </div>
                    );
                  }

                  // Regular row with individual sessions
                  return (
                    <div
                      class="time-slot-row"
                      id={`time-slot-${currentDay.slug}-${rowIndex}`}
                    >
                      <div class="time-column">
                        <div class="time-display">
                          <div class="start-time">
                            {new Date(row.startsAt).toLocaleTimeString(
                              "en-US",
                              {
                                hour12: false,
                                hour: "2-digit",
                                minute: "2-digit",
                              },
                            )}
                          </div>
                          <div class="end-time">
                            {new Date(row.endsAt).toLocaleTimeString("en-US", {
                              hour12: false,
                              hour: "2-digit",
                              minute: "2-digit",
                            })}
                          </div>
                        </div>
                      </div>

                      {row.cells.map((cell, cellIndex) => {
                        // Skip cells that are marked as hidden (e.g., spanned cells)
                        if (cell.hidden) return null;

                        // Find which room this cell index corresponds to
                        const roomForCell = currentDay.rooms[cellIndex];
                        if (!roomForCell)
                          return (
                            <div
                              class="empty-cell"
                              style={`grid-column: ${cellIndex + 2}`}
                            />
                          );

                        // Check if this room is one of our desired rooms
                        const roomIndex = desiredRooms.indexOf(
                          roomForCell.name,
                        );
                        if (roomIndex === -1) return null; // Skip rooms not in our desired list

                        // If no session in this cell, render empty cell
                        if (!cell.session) {
                          return (
                            <div
                              class="empty-cell"
                              style={`grid-column: ${roomIndex + 2}`}
                            />
                          );
                        }

                        const session = cell.session;
                        const duration = Math.round(
                          (new Date(session.endsAt).getTime() -
                            new Date(session.startsAt).getTime()) /
                            (1000 * 60),
                        );
                        const categoryColor = getTalkCategoryColor(session);
                        const track = getTrackName(session);
                        return (
                          <div
                            class="session-cell"
                            style={`grid-column: ${roomIndex + 2}`}
                            onclick={`window.location.href='${getTalkUrl(session)}'`}
                          >
                            <div
                              class="session-content"
                              data-talk-id={session.id}
                            >
                              <div class="session-duration">
                                {duration} minutes
                              </div>
                              <h3 class="session-title">
                                <a href={getTalkUrl(session)}>
                                  {session.title}
                                </a>
                              </h3>
                              {session.speakers?.length ? (
                                <div class="session-speakers">
                                  {session.speakers.map(
                                    (speaker: any, index: number) => (
                                      <>
                                        <a
                                          href={createSpeakerUrl(speaker.name)}
                                        >
                                          {speaker.name}
                                        </a>
                                        {index < session.speakers.length - 1 &&
                                          ", "}
                                      </>
                                    ),
                                  )}
                                </div>
                              ) : null}
                              {track && (
                                <div
                                  class="session-category"
                                  style={`background-color: ${categoryColor}`}
                                >
                                  {track}
                                </div>
                              )}
                              {/* TODO: Add like button */}
                              {/* <button
                              class="like-btn-desktop"
                              data-talk-id={session.id}
                              onclick={`event.stopPropagation(); toggleLike('${session.id}')`}
                              title="Like this talk"
                            >
                              ♡
                            </button> */}
                              <div
                                class="session-category-indicator"
                                style={`background-color: ${categoryColor}`}
                              />
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  );
                })
              }
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Mobile Card View -->
    <div class="agenda-main mobile-only">
      <div class="day-section active">
        <div class="day-header">{currentDay.label}</div>
        {
          currentDay.grid.map((row, rowIndex) => (
            <div
              class="time-slot-container"
              id={`time-slot-mobile-${currentDay.slug}-${rowIndex}`}
            >
              <div class="time-header">
                {new Date(row.startsAt).toLocaleTimeString("en-US", {
                  hour12: false,
                  hour: "2-digit",
                  minute: "2-digit",
                })}
              </div>
              <div class="sessions-container">
                {row.cells
                  .filter((cell) => cell.session && !cell.hidden)
                  .map((cell, cellIndex) => {
                    const session = cell.session!;
                    const duration = Math.round(
                      (new Date(session.endsAt).getTime() -
                        new Date(session.startsAt).getTime()) /
                        (1000 * 60),
                    );

                    const categoryColor = getTalkCategoryColor(session);

                    // If this is a service session (break), create non-interactive card
                    if (session.isServiceSession) {
                      return (
                        <div
                          class="session-card break-session-mobile"
                          data-talk-id={session.id}
                        >
                          <div class="session-header">
                            <div class="room-time-info">
                              {session.room && (
                                <span class="room-label">{session.room}</span>
                              )}
                              <span class="time-duration">
                                {new Date(session.startsAt).toLocaleTimeString(
                                  "en-US",
                                  {
                                    hour12: false,
                                    hour: "2-digit",
                                    minute: "2-digit",
                                  },
                                )}{" "}
                                → {duration} min
                              </span>
                            </div>
                          </div>
                          <h3 class="session-title break-title-mobile">
                            {session.title}
                          </h3>
                          <div
                            class="session-category-indicator"
                            style={`background-color: ${getTalkCategoryColor(session)}`}
                          />
                        </div>
                      );
                    }

                    // If this is a lightning group, create one card with all lightning talks
                    if (session.isLightningGroup && session.lightningChildren) {
                      return (
                        <div
                          class="session-card lightning-group-mobile"
                          data-talk-id={session.id}
                        >
                          <div class="session-header">
                            <div class="room-time-info">
                              {session.lightningChildren[0]?.room && (
                                <span class="room-label">
                                  {session.lightningChildren[0].room}
                                </span>
                              )}
                              <span class="time-duration">
                                {new Date(session.startsAt).toLocaleTimeString(
                                  "en-US",
                                  {
                                    hour12: false,
                                    hour: "2-digit",
                                    minute: "2-digit",
                                  },
                                )}{" "}
                                → {duration} min
                              </span>
                            </div>
                          </div>
                          <h3 class="session-title">Lightning Talks</h3>
                          <div class="lightning-talks-mobile-list">
                            {session.lightningChildren.map((child: any) => (
                              <div class="lightning-talk-item-mobile">
                                <h4 class="lightning-talk-title-mobile">
                                  <a href={getTalkUrl(child)}>{child.title}</a>
                                </h4>
                                <div class="lightning-talk-speakers-mobile">
                                  {child.speakers.map(
                                    (speaker: any, index: number) => (
                                      <>
                                        <a
                                          href={`/speakers/${speaker.name
                                            .toLowerCase()
                                            .replace(/[^\w\s-]/g, "")
                                            .replace(/\s+/g, "-")
                                            .replace(/-+/g, "-")
                                            .replace(/^-+|-+$/g, "")}`}
                                        >
                                          {speaker.name}
                                        </a>
                                        {index < child.speakers.length - 1 &&
                                          ", "}
                                      </>
                                    ),
                                  )}
                                </div>
                              </div>
                            ))}
                          </div>
                          <div
                            class="session-category-indicator"
                            style={`background-color: ${categoryColor}`}
                          />
                        </div>
                      );
                    }

                    // Regular session card
                    return (
                      <div class="session-card" data-talk-id={session.id}>
                        <div class="session-header">
                          <div class="room-time-info">
                            {session.room && (
                              <span class="room-label">{session.room}</span>
                            )}
                            <span class="time-duration">
                              {new Date(session.startsAt).toLocaleTimeString(
                                "en-US",
                                {
                                  hour12: false,
                                  hour: "2-digit",
                                  minute: "2-digit",
                                },
                              )}{" "}
                              → {duration} min
                            </span>
                          </div>
                          {/* <button
                          class="like-btn"
                          data-talk-id={session.id}
                          onclick={`event.stopPropagation(); toggleLike('${session.id}')`}
                          title="Like this talk"
                        >
                          ♡
                        </button> */}
                        </div>
                        <h3 class="session-title">
                          <a href={getTalkUrl(session)}>{session.title}</a>
                        </h3>
                        <div class="session-speakers">
                          {session.speakers.map(
                            (speaker: any, index: number) => (
                              <>
                                <a
                                  href={`/speakers/${speaker.name
                                    .toLowerCase()
                                    .replace(/[^\w\s-]/g, "")
                                    .replace(/\s+/g, "-")
                                    .replace(/-+/g, "-")
                                    .replace(/^-+|-+$/g, "")}`}
                                >
                                  {speaker.name}
                                </a>
                                {index < session.speakers.length - 1 && ", "}
                              </>
                            ),
                          )}
                        </div>
                        {getTrackName(session) && (
                          <div
                            class="session-category"
                            style={`background-color: ${categoryColor}`}
                          >
                            {getTrackName(session)}
                          </div>
                        )}
                        <div
                          class="session-category-indicator"
                          style={`background-color: ${getTalkCategoryColor(session)}`}
                        />
                      </div>
                    );
                  })}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</Layout>

<style lang="scss">
  .agenda-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
  }

  .agenda-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;

    h2 {
      margin: 0;
    }
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .demo-notice {
    background: var(--orange);
    color: white;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .current-time-btn {
    background: var(--blue);
    color: white;
    border: none;
    padding: 12px 20px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    transition: background-color 0.3s ease;

    &:hover {
      background: #3d4e73;
    }
  }

  .liked-section {
    margin-bottom: 30px;

    h3 {
      margin: 0 0 15px 0;
      font-size: 18px;
    }

    .liked-talks-container {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
  }

  /* Filter Toggle Button */
  .filter-toggle-container {
    display: flex;
    justify-content: flex-end;
    margin: 16px 0;
  }

  .filter-toggle-btn {
    background: var(--pink);
    color: white;
    border: 2px solid var(--pink);
    border-radius: 25px;
    padding: 12px 24px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(253, 106, 130, 0.3);

    &:hover {
      background: #e05574;
      border-color: #e05574;
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(253, 106, 130, 0.4);
    }

    .filter-icon {
      font-size: 18px;
    }

    .filter-arrow {
      font-size: 12px;
      transition: transform 0.3s ease;
    }

    &.active {
      background: #e05574;
      border-color: #e05574;

      .filter-arrow {
        transform: rotate(180deg);
      }
    }
  }

  /* Filter Section Styles */
  .filter-section {
    background: white;
    border: 2px solid #e5e7eb;
    border-radius: 16px;
    padding: 16px 24px;
    margin: 16px 0 24px 0;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    animation: slideDown 0.3s ease-out;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .filter-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 32px;
    margin-bottom: 12px;
  }

  .filter-column {
    display: flex;
    flex-direction: column;

    h4 {
      font-size: 18px;
      font-weight: 700;
      color: #374151;
      margin: 0 0 16px 0;
      padding-bottom: 8px;
      border-bottom: 2px solid #f3f4f6;
    }
  }

  .filter-options {
    display: flex;
    flex-direction: column;
  }

  .filter-checkbox {
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    padding: 8px 0;
    font-size: 15px;
    color: #6b7280;
    font-weight: 500;
    transition: color 0.2s ease;

    &:hover {
      color: #374151;
    }

    input[type="checkbox"] {
      position: absolute;
      opacity: 0;
      cursor: pointer;
      height: 0;
      width: 0;
    }

    .checkmark {
      height: 20px;
      width: 20px;
      background-color: #f9fafb;
      border: 2px solid #d1d5db;
      border-radius: 4px;
      position: relative;
      transition: all 0.2s ease;
    }

    &:hover .checkmark {
      border-color: var(--pink);
      background-color: #fef7f7;
    }

    input:checked ~ .checkmark {
      background-color: var(--pink);
      border-color: var(--pink);
    }

    .checkmark:after {
      content: "";
      position: absolute;
      display: none;
      left: 6px;
      top: 2px;
      width: 6px;
      height: 10px;
      border: solid white;
      border-width: 0 2px 2px 0;
      transform: rotate(45deg) translateX(-3px);
    }

    input:checked ~ .checkmark:after {
      display: block;
    }
  }

  .filter-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 16px;
    border-top: 1px solid #e5e7eb;
    flex-wrap: wrap;
    gap: 16px;
  }

  .reset-filters-btn {
    background: transparent;
    color: var(--pink);
    border: 2px solid var(--pink);
    border-radius: 25px;
    padding: 10px 24px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;

    &:hover {
      background: var(--pink);
      color: white;
      transform: translateY(-1px);
    }
  }
  /* Desktop/Mobile View Switching */
  .desktop-only {
    display: block;
  }

  .mobile-only {
    display: none;
  }

  /* Desktop Grid-based Schedule Styles */
  .agenda-grid-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .day-schedule {
    margin-bottom: 40px;

    &.hidden {
      display: none;
    }

    &.active {
      display: block;
    }
  }

  .schedule-header {
    background: var(--green);
    color: white;
    padding: 15px 25px;
    font-weight: 600;
    text-align: center;
