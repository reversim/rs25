  const getSessionTrackName = (session) => {
    const trackCategory = session.categories?.find((c) => c.name === "Track");
    const item = trackCategory?.categoryItems?.[0];
    if (!item) return null;
    const raw = item.name;
    if (raw === "AI Apps" || raw === "AI Infra") return "AI";
    return raw;
  };

  const getSessionCategoryColor = (session) => {
    const track = getSessionTrackName(session);
    if (!track) return "#506592";

    const categoryName = track.toLowerCase();
    const colorMap = {
      frontend: "#fd6a82",
      front: "#fd6a82",
      backend: "#f78750",
      back: "#f78750",
      ai: "#81c47a",
      "artificial intelligence": "#81c47a",
      data: "#81c47a",
      mobile: "#506592",
      devops: "#9d4edd",
      security: "#e63946",
      "ui/ux": "#f72585",
      design: "#f72585",
    };

    return colorMap[categoryName] || "#506592";
  };

  const formatTime = (dateString) => {
    const date = new Date(dateString);
    return date.toLocaleTimeString("en-US", {
      hour12: false,
      hour: "2-digit",
      minute: "2-digit",
    });
  };

  const formatDate = (dateString) => {
    const date = new Date(dateString);
    return date.toLocaleDateString("en-US", {
      weekday: "long",
      year: "numeric",
      month: "long",
      day: "numeric",
    });
  };

  const createSlug = (text) => {
    return text
      .toLowerCase()
      .replace(/[^\w\s-]/g, "") // Remove special characters
      .replace(/\s+/g, "-") // Replace spaces with hyphens
      .replace(/-+/g, "-") // Replace multiple hyphens with single
      .replace(/^-+|-+$/g, ""); // Remove leading/trailing hyphens
  };

  const createSpeakerUrl = (speakerName) => {
    return `/speakers/${createSlug(speakerName)}`;
  };

  const createTalkUrl = (talkTitle) => {
    return `/talks/${createSlug(talkTitle)}`;
  };

  const findSessionById = (sessionId) => {
    return sessionsData.find((session) => session.id === sessionId);
  };

  // Filtering Functions
  function applyFilters() {
    // Get all selected values from checkboxes
    const selectedThemes = Array.from(
      document.querySelectorAll("#theme-filters input:checked"),
    ).map((cb) => cb.value);
    const selectedRooms = Array.from(
      document.querySelectorAll("#room-filters input:checked"),
    ).map((cb) => cb.value);

    // Filter desktop cards (including lightning talk cards)
    const desktopCards = document.querySelectorAll(".session-content");
    const desktopBreaks = document.querySelectorAll(".break-session-content");
    const desktopBreakCells = document.querySelectorAll(".break-session-cell");

    // Filter mobile cards (including lightning talk cards)
    const mobileCards = document.querySelectorAll(".session-card");

    let visibleCount = 0;
    let totalCount = 0;

    // Apply filters to desktop session cards
    [...desktopCards, ...desktopBreaks].forEach((card) => {
      const sessionId = card.getAttribute("data-talk-id");
      const session = findSessionById(sessionId);

      if (session) {
        totalCount++;

        // Check theme match
        const track = getSessionTrackName(session);
        const matchesTheme =
          selectedThemes.length === 0 ||
          (track && selectedThemes.includes(track));

        // Check room match
        const matchesRoom =
          selectedRooms.length === 0 || selectedRooms.includes(session.room);

        if (matchesTheme && matchesRoom) {
          card.style.opacity = "1";
          card.style.transform = "scale(1)";
          card.style.transition = "all 0.3s ease";
          visibleCount++;
        } else {
          card.style.opacity = "0.1";
          card.style.transform = "scale(0.95)";
          card.style.transition = "all 0.3s ease";
        }
      }
    });

    // Apply filters to desktop full-width break session cells
    desktopBreakCells.forEach((cell) => {
      const sessionId = cell.getAttribute("data-talk-id");
      const session = findSessionById(sessionId);

      if (session) {
        totalCount++;

        // Check theme match
        const track = getSessionTrackName(session);
        const matchesTheme =
          selectedThemes.length === 0 ||
          (track && selectedThemes.includes(track));

        // Check room match
        const matchesRoom =
          selectedRooms.length === 0 || selectedRooms.includes(session.room);

        // Apply visual changes to the content only (like regular session cards)
        const breakContent = cell.querySelector(".break-session-content");
        if (breakContent) {
          if (matchesTheme && matchesRoom) {
            breakContent.style.opacity = "1";
            breakContent.style.transform = "scale(1)";
            breakContent.style.transition = "all 0.3s ease";
            visibleCount++;
          } else {
            breakContent.style.opacity = "0.1";
            breakContent.style.transform = "scale(0.95)";
            breakContent.style.transition = "all 0.3s ease";
          }
        }
      }
    });

    // Apply filters to mobile session cards
    mobileCards.forEach((card) => {
      const sessionId = card.getAttribute("data-talk-id");
      const session = findSessionById(sessionId);

      if (session) {
        const track = getSessionTrackName(session);
        const matchesTheme =
          selectedThemes.length === 0 ||
          (track && selectedThemes.includes(track));
        const matchesRoom =
          selectedRooms.length === 0 || selectedRooms.includes(session.room);

        if (matchesTheme && matchesRoom) {
          card.style.opacity = "1";
          card.style.transform = "scale(1)";
          card.style.transition = "all 0.3s ease";
        } else {
          card.style.opacity = "0.1";
          card.style.transform = "scale(0.95)";
          card.style.transition = "all 0.3s ease";
        }
      }
    });
  }

  function clearAllFilters() {
    // Uncheck all checkboxes
    document
      .querySelectorAll('.filter-section input[type="checkbox"]')
      .forEach((checkbox) => {
        checkbox.checked = false;
      });

    // Reset all cards to visible
    const allCards = document.querySelectorAll(
      ".session-content, .break-session-content, .break-session, .session-card",
    );
    allCards.forEach((card) => {
      card.style.opacity = "1";
      card.style.transform = "scale(1)";
      card.style.transition = "all 0.3s ease";
    });

    // Filters cleared successfully
  }

  // Filter Toggle Function
  function toggleFilters() {
    const filterSection = document.getElementById("filter-section");
    const toggleBtn = document.querySelector(".filter-toggle-btn");

    if (filterSection.style.display === "none") {
      filterSection.style.display = "block";
      toggleBtn.classList.add("active");
    } else {
      filterSection.style.display = "none";
      toggleBtn.classList.remove("active");
    }
  }

  // Make functions globally available
  window.applyFilters = applyFilters;
  window.clearAllFilters = clearAllFilters;
  window.toggleFilters = toggleFilters;
</script>
