---
import AgendaDaySwitcher from "../../components/agenda/agendaDaySwitcher.astro";
import AgendaGridDesktop from "../../components/agenda/desktop/agendaGridDesktop.astro";
import AgendaHero from "../../components/agenda/hero.astro";
import AgendaGridMobile from "../../components/agenda/mobile/agendaGridMobile.astro";
import { buildDayGrid, getAgendaDays } from "../../helpers/getAgenda";
import Layout from "../../layouts/Layout.astro";
import FilterSessions from "../../components/agenda/filterSessions.astro";
import ScrollToNowButton from "../../components/agenda/scrollToNowButton.astro";

export async function getStaticPaths() {
  const agendaDays = await getAgendaDays();
  return agendaDays.map((day) => {
    const grid = buildDayGrid(day);

    return {
      params: { day: day.slug },
      props: {
        currentDay: {
          ...day,
          grid: grid,
        },
        availableDays: agendaDays,
      },
    };
  });
}

const { currentDay, availableDays } = Astro.props;
---

<Layout havePadding={false}>
  <div class="agenda-container">
    <AgendaHero currentDay={currentDay} />

    <!-- Liked talks section (initially hidden) -->
    <!-- <LikeTalkSection currentDay={currentDay} agendaDays={availableDays} /> -->

    <!-- Day switcher -->
    <AgendaDaySwitcher
      availableDays={availableDays}
      currentDaySlug={currentDay.slug}
    />

    <FilterSessions currentDay={currentDay} />

    <ScrollToNowButton currentDay={currentDay} />

    <!-- Desktop Grid-based Schedule View -->
    <AgendaGridDesktop currentDay={currentDay} />

    <!-- Mobile Card View -->
    <AgendaGridMobile currentDay={currentDay} />
  </div>
</Layout>

<style lang="scss">
  .agenda-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
    margin-bottom: 40px;
    position: relative;
  }
</style>
