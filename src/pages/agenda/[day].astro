---
import Layout from "../../layouts/Layout.astro";
import { getAgendaDays, buildDayGrid, getTrackName } from "../../helpers/getAgenda";
import type { AgendaDay } from "../../helpers/getAgenda";
import { getSpeakers } from "../../helpers/getSpeakers";
import slug from 'slug';

export async function getStaticPaths() {
  const days = await getAgendaDays();
  return days.map(d => ({ params: { day: d.slug } }));
}

const { day } = Astro.params;
const days = await getAgendaDays();
const current: AgendaDay | undefined = days.find(d => d.slug === day);

if (!current) {
  return Astro.redirect('/agenda');
}

// Build speaker slug map by full name (case-insensitive)
const allSpeakers = await getSpeakers();
const nameToSlug = new Map(allSpeakers.map(s => [s.fullName.toLowerCase().trim(), s.slug]));
function speakerSlugFor(name: string) {
  return nameToSlug.get(name.toLowerCase().trim()) || name.toLowerCase().replace(/\s+/g,'-');
}

const grid = buildDayGrid(current);
const roomCount = current.rooms.length;
---
<Layout havePadding={false}>
  <div class="agenda-wrapper" style={`--room-count:${roomCount};`}>
    <div class="agenda-header">
      <h1>{current.label}</h1>
      <nav class="days-nav" aria-label="Agenda days navigation">
        {days.map(d => (
          <a class={`day-link ${d.slug === current.slug ? 'active' : ''}`} href={`/agenda/${d.slug}`}>{d.label}</a>
        ))}
      </nav>
    </div>

    <div class="agenda-grid" role="table" aria-label={`Agenda for ${current.label}`}>
      <div class="rooms-row" role="row">
        <div class="time-col head" role="columnheader">Time</div>
        {current.rooms.map(r => (
          <div class="room head" role="columnheader">{r.name}</div>
        ))}
      </div>
      {grid.map(slot => (
        <div class={`slot-row ${slot.shortRow ? 'short' : ''}`} role="row">
          <div class="time-col" role="cell">
            <div>{new Date(slot.startsAt).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'})}</div>
            <div class="time-end">{new Date(slot.endsAt).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'})}</div>
          </div>
          {slot.cells.map(cell => cell.hidden ? null : (
            <div class={`session ${cell.session ? '' : 'empty'} ${cell.session?.isPlenumSession ? 'plenum' : ''} ${cell.session && /(coffee\s*&\s*pastries(?:\s*break)?|lunch(?:\s*break)?)/i.test(cell.session.title) ? 'food-break' : ''} ${cell.session?.isLightningGroup ? 'lightning-group' : ''}`} role="cell" style={cell.span && cell.span>1 ? `grid-column: span ${cell.span};` : ''} data-title={cell.session?.title}>
              {cell.session && (
                <div class="session-inner">
                  {!cell.session.isLightningGroup && (
                    <div class="session-time-mobile">{new Date(slot.startsAt).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'})} – {new Date(slot.endsAt).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'})}</div>
                  )}
                  {cell.session.isLightningGroup ? (
                    <>
                      <h3 class="title">{cell.session.title}</h3>
                      <ul class="lightning-list">
                        {cell.session.lightningChildren?.map(child => (
                          <li>
                            <span class="lt-title">{child.isServiceSession ? child.title : <a href={`/talks/${slug(child.title)}`}>{child.title}</a>}</span>
                            {child.speakers?.length ? (
                              <span class="lt-speakers">
                                {' '}
                                {child.speakers.map((s,i) => (
                                  <>
                                    <a href={`/speakers/${speakerSlugFor(s.name)}`}>{s.name}</a>{i < child.speakers.length - 1 ? ', ' : ''}
                                  </>
                                ))}
                              </span>
                            ) : null}
                          </li>
                        ))}
                      </ul>
                    </>
                  ) : (
                    <>
                      <h3 class="title"><a href={`/talks/${slug(cell.session.title)}`}>{cell.session.title}</a></h3>
                      {cell.session.speakers?.length ? (
                        <p class="speakers">
                          {cell.session.speakers.map((s, i) => (
                            <>
                              <a href={`/speakers/${speakerSlugFor(s.name)}`}>{s.name}</a>{i < cell.session.speakers.length - 1 ? ', ' : ''}
                            </>
                          ))}
                        </p>
                      ) : null}
                      {cell.session.isServiceSession ? <p class="service-tag">Break</p> : null}
                      {getTrackName(cell.session) ? <p class="track-tag">{getTrackName(cell.session)}</p> : null}
                    </>
                  )}
                </div>
              )}
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</Layout>

<style>
  .agenda-wrapper { max-width: 1400px; margin:auto; padding: 20px 4%; }
  .agenda-header { display:flex; flex-direction:column; gap:20px; align-items:center; }
  .agenda-header h1 { margin:10px 0 0; font-weight:300; font-size:40px; }
  .days-nav { display:flex; flex-wrap:wrap; gap:10px; justify-content:center; }
  .day-link { padding:8px 18px; background:#fff; border:1px solid var(--pink); color:var(--pink); border-radius:30px; font-size:14px; font-weight:500; transition:.2s; }
  .day-link.active { background: var(--pink); color:#fff; }
  .day-link:hover { background: var(--orange); border-color: var(--orange); color:#fff; }

  .agenda-grid { display:grid; gap:2px; margin-top:30px; }
  .rooms-row { display:grid; grid-template-columns: 140px repeat(var(--room-count), 1fr); position:sticky; top:0; z-index:10; background:var(--pink); color:#fff; }
  .rooms-row .room, .rooms-row .time-col { padding:10px; font-weight:600; font-size:14px; }

  .slot-row { display:grid; grid-template-columns: 140px repeat(var(--room-count), 1fr); }
  .time-col { background:#fff; border:1px solid #ddd; font-size:12px; padding:8px; display:flex; flex-direction:column; gap:4px; }
  .time-end { opacity:0.6; font-size:11px; }
  .session { background:#fff; border:1px solid #ddd; padding:0; position:relative; display:flex; }
  .session.empty { background:#f7f7f7; }
  .session-inner { padding:10px 12px; display:flex; flex-direction:column; gap:6px; width:100%; }
  .session .title { font-size:14px; line-height:1.3; margin:0; font-weight:600; }
  .session .speakers { font-size:12px; opacity:0.85; margin:0; }
  .session .speakers a { color: inherit; text-decoration: underline; }
  .session .speakers a:hover { text-decoration: none; }
  .service-tag, .track-tag { margin:0; font-size:10px; text-transform:uppercase; letter-spacing:0.5px; font-weight:600; }
  .track-tag { color: var(--pink); margin-top:auto; align-self:flex-start; }
  .session.plenum .track-tag { color:#fff; }
  .session.plenum .title { font-size:16px; }
  .session.food-break { background: linear-gradient(135deg, var(--orange), var(--pink)); border-color: var(--orange); color:#fff; box-shadow:0 0 0 2px #fff inset; }
  .session.food-break .title { font-size:15px; }
  .session.food-break .service-tag, .session.food-break .track-tag { color:#fff; }

  .session.lightning-group { background:var(--pink); color:#fff; border-color:var(--pink); }
  .session.lightning-group .title { font-size:15px; letter-spacing:0.5px; text-transform:uppercase; }
  .lightning-list { list-style:none; margin:6px 0 0; padding:0; display:grid; gap:4px; }
  .lightning-list li { display:flex; flex-wrap:wrap; gap:4px; font-size:12px; background:rgba(255,255,255,0.12); padding:6px 8px; border-radius:4px; }
  .lightning-list .lt-title { font-weight:600; }
  .lightning-list a { color:#fff; text-decoration:underline; }
  .lightning-list a:hover { text-decoration:none; }
  .session.lightning-group .track-tag, .session.lightning-group .service-tag { display:none; }

  .slot-row.short .time-col { padding:4px 6px; font-size:11px; }
  .slot-row.short .session-inner { padding:4px 6px; gap:4px; }
  .slot-row.short .session .title { font-size:12px; }
  .slot-row.short .session .speakers { font-size:10px; }
  .slot-row.short .session { border-width:1px; }
  .slot-row.short .session.plenum .title { font-size:14px; }

  @media (max-width: 900px) {
    .rooms-row { display:none; }
    .slot-row { display:flex; flex-direction:column; border:1px solid #ddd; margin-bottom:14px; border-radius:8px; overflow:hidden; }
    .time-col { flex-direction:row; justify-content:space-between; background: var(--pink); color:#fff; border:none; font-size:14px; }
    .session { border:none; border-top:1px solid #eee; }
    .session-inner { padding:14px 16px; }
    .session-time-mobile { font-size:12px; text-transform:uppercase; letter-spacing:1px; opacity:0.7; }
    .session .title { font-size:16px; }
    .session .speakers { font-size:13px; }
    .slot-row.short { margin-bottom:8px; }
    .slot-row.short .session-inner { padding:10px 14px; }
    .slot-row.short .session .title { font-size:14px; }
    .slot-row.short .session .speakers { font-size:12px; }
  }
  .session .title a, .lightning-list .lt-title a { color: inherit; text-decoration:none; }
  .session .title a:hover, .lightning-list .lt-title a:hover { text-decoration:underline; }
</style>
