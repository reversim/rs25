---
import { getImage, Picture } from "astro:assets";
import Asterisk from "../assets/asterisk.svg";
import rs24Image from "../assets/reversim24-image.png";
import { getSponsors } from "../helpers/getSponsors";
import SponsorDialog from "./sponsorDialog.astro";
import Title from "./title.astro";
import { Image } from "astro:assets";

const optimizedRS24ImageMobile = await getImage({
  src: rs24Image,
  width: 1280,
});
const optimizedRS24ImageDesktop = await getImage({
  src: rs24Image,
  width: 1920,
});

const organizingSponsor = await getSponsors("organizing");
const communitySponsors = await getSponsors("community");
const gameChangersSponsors = await getSponsors("game-changers");

const cssVars = `
.card-background {
    --optimizedRS24URLMobile: url(${optimizedRS24ImageMobile.src});
    --optimizedRS24URLDesktop: url(${optimizedRS24ImageDesktop.src})
    }`;
---

<script src="https://flackr.github.io/scroll-timeline/dist/scroll-timeline.js"
></script>
<script
  src="https://cdn.jsdelivr.net/npm/reversim-machine/dist/reversim-machine.umd.js"
></script>
<!--<script src="http://localhost:8080/dist/reversim-machine.umd.js"></script>-->
<script is:inline>
  const minMachineWidth = 1000;
  document.documentElement.style.setProperty(
    "--minMachineWidth",
    `${minMachineWidth}px`,
  );
  let machineStarted = false;

  function startMachine() {
    ReversimMachine.init(document.querySelector("#machine"), {
      debug: false,
      browserTargetBoundingBox: document.getElementById("machine-stage"),
      frameTopLeft: { x: 0, y: 0 },
      frameBottomRight: { x: 1000, y: 1000 },
      onAirMachineStart: () => {
        const asterisk = document.querySelector(".asteriskContainer");
        if (asterisk) {
          asterisk.classList.add("spinning");
        }
      },
    });
    machineStarted = true;
  }

  document.addEventListener("DOMContentLoaded", async () => {
    if (window.innerWidth >= minMachineWidth) {
      startMachine();
    }
  });

  window.addEventListener("resize", () => {
    if (machineStarted && window.innerWidth < minMachineWidth) {
      ReversimMachine.destroy();
      machineStarted = false;
    } else if (!machineStarted && window.innerWidth >= minMachineWidth) {
      startMachine();
    }
  });

  // Dialog functionality for community sponsors
  document.addEventListener("DOMContentLoaded", () => {
    // Add click handlers for clickable sponsor images
    document.querySelectorAll(".clickable-sponsor").forEach((sponsorImg) => {
      sponsorImg.addEventListener("click", (e) => {
        e.preventDefault();
        const sponsorSlug = e.target.closest(".sponsor-item").dataset.sponsor;
        const dialog = document.getElementById(`sponsor-dialog-${sponsorSlug}`);
        if (dialog) {
          dialog.showModal();
        }
      });
    });

    // Add click handlers for close dialog buttons
    document.querySelectorAll(".close-dialog").forEach((closeBtn) => {
      closeBtn.addEventListener("click", (e) => {
        const sponsorSlug = e.target.closest(".close-dialog").dataset.sponsor;
        const dialog = document.getElementById(`sponsor-dialog-${sponsorSlug}`);
        if (dialog) {
          dialog.close();
        }
      });
    });

    // Close dialog when clicking outside the content
    document.querySelectorAll(".sponsor-dialog").forEach((dialog) => {
      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) {
          dialog.close();
        }
      });
    });
  });
</script>

<div id="machine"></div>
<div class="main-banner">
  <div class="machine-layout">
    <div id="machine-stage"></div>
    <div class="hero-container">
      <div class="hero-content">
        <div class="title-container">
          <h2 class="title green">REVERSIM</h2>
          <h2 class="title orange">AUTUMN</h2>
          <h2 class="title blue">
            SUMMIT<p class="title pink asteriskContainer">
              <Asterisk class="asterisk" />
              <Asterisk class="asterisk" />
            </p>
          </h2>
        </div>
        <div class="event-date">
          <p>October 27-28, 2025</p>
        </div>
      </div>
      <div class="hero-btn-container">
        <a
          class="hero-btn"
          target="_blank"
          href="https://ti.to/reversim-summit/2025"
        >
          <button>Get Your Ticket Now!</button>
          <div class="wave"></div>
        </a>
      </div>
    </div>
  </div>

  <div class="sponsors card-background card">
    <div class="description-container">
      <p class="event-description" id="about">
        Reversim Summit 2025 (RS25) is a community driven event in Israel for
        software developers, product managers, data scientists and everyone else
        in the software industry. With an enthusiastic team of volunteers we've
        been creating a content-first software conferences since 2013 and
        successfully leading the market. Reversim Summit (RS) is not for profit
        and its sole purpose is to enrich the community with content and
        networking. We are grateful to have such an excellent top of the
        industry team of volunteer moderators and event organizers.
      </p>

      <Title
        type="sponsor-large"
        style="margin: 25px 0 24px"
        title="Organizing Sponsor"
        id="sponsors"
      />
      <div class="sponsors-container organizer">
        {
          organizingSponsor.map((sponsor) => (
            <a
              class={`${sponsor.slug} logo-container`}
              href={`/sponsors/${sponsor.slug}`}
            >
              <Image
                class={`organizer sponsor-logo ${sponsor.slug}`}
                src={sponsor.companyNameLogo}
                width={300}
                height={150}
                alt={`Sponsor ${sponsor.companyName}`}
              />
            </a>
          ))
        }
      </div>
      {
        gameChangersSponsors.length && (
          <>
            <Title
              type="sponsor-medium"
              style="margin: 36px 0 18px"
              title="Game Changers Sponsors"
              id="sponsors"
            />
            <div class="sponsors-container game-changers">
              {gameChangersSponsors.map((sponsor) => (
                <a
                  class={`${sponsor.slug} logo-container`}
                  href={`/sponsors/${sponsor.slug}`}
                >
                  <Image
                    class={`sponsor-logo`}
                    src={sponsor.companyNameLogo}
                    width={400}
                    height={1000}
                    alt={`Sponsor ${sponsor.companyName}`}
                  />
                </a>
              ))}
            </div>
          </>
        )
      }
      {
        communitySponsors?.length && (
          <>
            <Title
              type="sponsor-medium"
              style="margin: 42px 0 18px"
              title="Community Sponsors"
              id="sponsors"
            />
            <div class="community sponsors-container">
              {communitySponsors.map((sponsor) => (
                <div class="sponsor-item" data-sponsor={sponsor.slug}>
                  <Image
                    class={`sponsor-logo ${sponsor.slug} clickable-sponsor`}
                    src={sponsor.companyNameLogo}
                    width={400}
                    height={1000}
                    alt={`Sponsor ${sponsor.companyName}`}
                  />
                </div>
              ))}
            </div>
          </>
        )
      }
    </div>
  </div>

  <!-- Dialog elements for community sponsors -->
  {communitySponsors?.map((sponsor) => <SponsorDialog sponsor={sponsor} />)}
</div>

<style set:html={cssVars}></style>

<style is:global>
  #machine {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    aspect-ratio: 1.5;
    canvas {
      width: 100%;
      height: 100%;
    }
  }
</style>

<style lang="scss">
  .main-banner {
    .machine-layout {
      display: flex;
      align-items: center;
      justify-content: center;
      align-items: flex-start;
      view-timeline: --sponsorsReveal block;
      // margin: 0 12%;

      @media screen and (max-width: 1300px) {
        height: 600px;
      }

      @media (max-width: 768px) {
        height: 480px;
      }

      #machine-stage {
        aspect-ratio: 1;
        height: 600px;

        @media screen and (max-width: 1300px) {
          height: 500px;
        }

        @media screen and (max-width: 1000px) {
          display: none;
        }
      }

      .hero-container {
        margin-left: 143px;
        padding-top: 75px;

        @media screen and (max-width: 1000px) {
          margin-left: 0;
        }
      }

      .asteriskContainer.spinning {
        animation: spin 6s linear infinite;
        @keyframes spin {
          from {
            transform: rotate(0deg);
          }
          to {
            transform: rotate(360deg);
          }
        }
      }
    }

    .hero-container {
      display: flex;
      flex-direction: column;
      justify-content: center;
      pointer-events: none;

      .title-container {
        font-size: 80px;
        font-weight: 700;
        .title {
          width: max-content;
          font-size: 1em;
          font-weight: inherit;
          margin: 0 auto;
          line-height: 1;
          --textShadow: #c1c1c182;

          &.green {
            color: var(--green);
            transform: translateX(-0.7em);
            text-shadow: -6px -4px 0px var(--textShadow);
          }

          &.orange {
            color: var(--orange);
            transform: translateX(0.3em);
            text-shadow: -6px 4px 0px var(--textShadow);

            @media screen and (min-width: 1200px) {
              transform: translateX(1.71em);
            }
          }

          &.blue {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 12px;
            color: var(--blue);
            transform: translateX(-1em);
            text-shadow: -4px -6px 0px var(--textShadow);

            @media screen and (min-width: 1200px) {
              transform: translateX(-1.47em);
            }
          }

          &.pink {
            position: relative;
            width: 0.8em;
            aspect-ratio: 1;
            svg {
              position: absolute;
              top: 0;
              left: 0;
              width: 100%;
              height: 100%;
              fill: var(--pink);
            }

            svg:nth-child(2) {
              left: -6px;
              top: -4px;
              fill: var(--textShadow);
              z-index: -1;
            }
          }
        }

        @media (max-width: 992px) {
          font-size: 60px;
        }

        @media (max-width: 768px) {
          font-size: 36px;
        }
      }

      .event-date {
        margin-top: 40px;
        font-weight: 600;
        font-size: 32px;
        p {
          text-align: center;
        }

        @media (max-width: 768px) {
          font-size: 24px;
        }
      }
    }

    .card-background {
      --border-height: 12px;
      height: max-content;
      width: 100%;
      background-color: #171c3e;
      clip-path: ellipse(133% 100% at 40% 100%);

      position: relative;
      padding: 8% 10%;
      border-bottom: var(--border-height) solid #9e9e9e;

      @media (max-width: 768px) {
        clip-path: ellipse(225% 100% at 40% 100%);
      }

      &::after {
        content: "";
        position: absolute;
        width: 100%;
        height: var(--border-height);

        background-image: linear-gradient(
          to right,
          #e4e4e4 60%,
          rgba(255, 255, 255, 0) 0%
        );
        top: calc(100% + var(--border-height) / 2);
        right: 0;

        background-size: 12px 2px;
        background-repeat: repeat-x;

        animation: scrollBackground linear both;
        animation-timeline: scroll(block root);
      }

      @keyframes scrollBackground {
        0% {
          background-position: 0% 0%;
        }
        100% {
          background-position: 12% 0%;
        }
      }

      &::before {
        content: "";
        position: absolute;

        width: 100%;
        height: 100%;
        top: 0;
        right: 0;
        opacity: 0.3;
        z-index: -1;

        background:
          linear-gradient(
            122deg,
            black 0%,
            rgba(0, 0, 0, 0.8) 30%,
            transparent 100%
          ),
          var(--optimizedRS24URLDesktop);
        background-size: 128%;
        background-position: center;

        clip-path: inherit;
        filter: grayscale(1);
      }

      .description-container {
        max-width: var(--max-container-width);
        margin: auto;

        .event-description {
          color: white;
          font-weight: 400;
          font-size: 16px;
          max-width: 64%;
          line-height: 1.5rem;

          @media screen and (max-width: 768px) {
            max-width: 95%;
          }
          @media screen and (max-width: 576px) {
            padding-top: 24px;
          }
        }
        .title-container {
          margin-top: 40px;
        }
      }

      .sponsors-container {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 48px 32px;

        &.community {
          gap: 12px 18px;

          .sponsor-item {
            display: flex;
            align-items: center;

            &[data-sponsor="startio"] {
              height: 38px;
            }
          }

          .sponsor-logo {
            height: 32px;
            cursor: pointer;
          }
        }

        .logo-container {
          display: flex;
          height: 48px;

          &.tenable {
            height: 55px;
            transform: translateY(-5px);
          }

          &.plus500 {
            height: 44px;
            transform: translateY(-7px);
          }
          &.workday {
            height: 86px;
            transform: translateY(-20px);
          }
          &.cyera {
            height: 34px;
          }
          &.titan {
            height: 40px;
          }
          &.wsc-sports {
            height: 39px;
          }
          &.elementor {
            height: 52px;
          }
          &.arpeely {
            height: 58px;
          }
          &.mobileye {
            height: 40px;
            transform: translateY(-2px);
          }
          &.honeybook {
            height: 60px;
          }
          &.ai21 {
            height: 30px;
          }
          &.intuit {
            height: 28px;
          }
          &.monday {
            height: 58px;
          }
          &.riverside {
            height: 44px;
          }
          &.zenity {
            height: 44px;
          }
          &.connecteam {
            height: 28px;
          }
        }
        .sponsor-logo {
          filter: brightness(0) invert(1);
          object-fit: contain;
          height: 100%;
          width: auto;
          max-width: 300px;
          align-self: center;
          transition: scale 0.2s ease;

          &.teads{
            filter: brightness(1) invert(0);
          }

          &:hover {
            scale: 1.05;
          }

          &.organizer {
            height: 65px;
          }
        }

        @media (max-width: 768px) {
          flex-direction: column;
          align-items: center;
          gap: 20px;

          &.game-changers {
            transform: translateX(-18px);
            // align-items: center;
          }

          &.community {
            flex-direction: row;
            justify-content: center;
            row-gap: 18px;
            column-gap: 24px;
          }

          .logo-container {
            transform: translateY(0px) !important;

            &[class*="logo-container"] {
              scale: 0.8;
            }
          }
        }
      }

      @media (max-width: 768px) {
        &::before {
          background-image: var(--optimizedRS24URLMobile);
          background-repeat: no-repeat;
          background-size: cover;
        }
      }
    }
  }

  .hero-btn-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 40px;
    margin-top: 60px;

    @media (max-width: 768px) {
      gap: 20px;
    }
  }

  .hero-btn {
    position: relative;
    border: none;
    width: 286px;
    align-self: center;
    justify-self: center;
    border-radius: 50px;

    background-color: #e75a80;
    cursor: pointer;
    box-shadow: 4px 4px 0px #c1c1c182;
    transition: all 0.15s ease-in;

    .wave,
    .wave:before,
    .wave:after {
      opacity: 1;
      transition: all 0.15s ease-in;
    }

    &:hover {
      .wave {
        opacity: 0;
      }
    }

    &.speaker {
      background-color: var(--orange);

      .wave {
        background-color: #fa744d;
        &::after,
        &::before {
          background-color: var(--orange);
        }
      }
    }

    .wave {
      position: absolute;
      background-color: #d95579;
      border-radius: 30px 30px 0;
      width: 50%;
      height: 100%;
      top: 0;
      left: 0;
      z-index: 1;

      // TODO - improve wave
      &::after {
        content: "";
        content: "";
        position: absolute;
        width: 17px;
        height: 100%;
        right: 0px;
        top: 0px;
        background-color: #e75a80;
        border-radius: 0px 500%;
        rotate: -2deg;
      }
      &::before {
        content: "";
        content: "";
        position: absolute;
        width: 17px;
        height: 100%;
        right: -5px;
        top: 0px;
        background-color: #e75a80;
        border-radius: 0px 500%;
        rotate: -2deg;
      }
    }

    button {
      color: white;
      background: none;
      border: none;
      cursor: pointer;
      font-size: 18px;
      pointer-events: all;

      font-weight: bold;
      padding: 12px 24px;
      margin: auto;
      display: block;

      position: relative;
      z-index: 2;

      &::before,
      &::after {
        content: "";
        position: absolute;
        top: 0;
        width: 3px;
        height: 100%;
        background-color: white;
        transition: right 0.5s ease;
      }
      &::before {
        right: 100%;
      }
      &::after {
        right: 0;
      }

      &:hover {
        &::before {
          right: 0px;
        }
        &::after {
          right: 100%;
        }
      }
    }
  }

  @media screen and (max-width: 768px) {
    .game-changers {
      justify-content: center;
      gap: 20px;
    }
  }
</style>
