---
const { href, backToText = "" } = Astro.props;
import Arrow from "../assets/agenda/arrow.svg";
---

<a id="back-button" class="back-button" href={href}>
  <Arrow class="arrow" /> Back to {backToText}</a
>

<style>
  .back-button {
    display: flex;
    align-items: center;
    gap: 12px;

    width: max-content;
    height: max-content;
    cursor: pointer;
    margin-bottom: 12px;

    color: var(--dark-blue);
    font-family: inherit;
    font-weight: 600;

    .arrow {
      height: 16px;
      width: 16px;
      -webkit-transform: scaleX(-1);
      transform: scaleX(-1);
    }
  }
</style>
