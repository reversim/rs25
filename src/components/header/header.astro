---
import { Image } from "astro:assets";
import logo from "../../assets/rs-26-logo.png";
import { event } from "../../config/event";
import { navLinks } from "../../config/nav";
import { getAgendaCurrentDay } from "../../helpers/data/getAgendaCurrentDay";
import HeaderLink from "./headerLink.astro";
import NavDrawer from "./navDrawer.astro";
import {
  AnalyticsEvent,
  ButtonId,
  NavLocation,
  analyticsAttrs,
} from "../../config/analytics";

const currentDayUrl = await getAgendaCurrentDay();
---

<div class="header">
  <div class="inner-container">
    <a
      class="logo-link"
      href="/"
      aria-label="Reversim home"
      {...analyticsAttrs(AnalyticsEvent.NavClick, {
        nav_location: NavLocation.Logo,
        nav_label: event.name,
        nav_href: "/",
      })}
    >
      <Image class="logo" src={logo} alt={event.name} height={100} />
    </a>
    <div class="navbar-container">
      {
        navLinks.map((link) => (
          <HeaderLink link={link.href} label={link.label} />
        ))
      }
      <span class="head-date">{event.dates}</span>
    </div>
    <button
      class="nav-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="navDrawer"
      {...analyticsAttrs(AnalyticsEvent.ButtonClick, {
        button_id: ButtonId.NavMenuToggle,
      })}
    >
      <i></i><i></i><i></i>
    </button>
  </div>
</div>

<NavDrawer />

<style lang="scss">
  @use "../../styles/breakpoints" as *;

  .header {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 99999;
    height: var(--header-height);
    background: rgba(10, 22, 49, 0.6);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--rs26-navy-line);
  }

  .inner-container {
    max-width: var(--rs26-maxw);
    margin: auto;
    padding: 8px clamp(18px, 4vw, 40px);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    position: relative;
    top: 50%;
    transform: translateY(-50%);
  }

  .logo-link {
    display: flex;
    align-items: center;

    .logo {
      height: 34px;
      width: auto;
    }
  }

  .navbar-container {
    display: flex;
    align-items: center;
    gap: 6px;

    @media screen and (max-width: $breakpoint-large) {
      display: none;
    }
  }

  .nav-toggle {
    display: none;
    position: relative;
    margin-left: auto;
    flex: 0 0 auto;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 0;
    border-radius: 12px;
    border: 1px solid var(--rs26-navy-line);
    background: rgba(108, 140, 199, 0.1);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;

    @media screen and (max-width: $breakpoint-large) {
      display: flex;
    }

    // The button is 40px so it fits the 60px header bar; the tap target is
    // pushed back out to the 44px accessibility floor.
    &::before {
      content: "";
      position: absolute;
      inset: -2px;
    }

    i {
      display: block;
      width: 19px;
      height: 2px;
      border-radius: 2px;
      background: #e6ecfb;
      transition:
        transform 0.28s var(--rs26-ease),
        opacity 0.18s;
    }

    &[aria-expanded="true"] {
      i:nth-child(1) {
        transform: translateY(7px) rotate(45deg);
      }

      i:nth-child(2) {
        opacity: 0;
      }

      i:nth-child(3) {
        transform: translateY(-7px) rotate(-45deg);
      }
    }
  }

  // While the drawer is open the bar goes transparent so the panel's own
  // gradient shows through; the logo and the X stay above it.
  :global(body.nav-open) .header {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom-color: transparent;
  }

  :global(body.nav-open) .nav-toggle {
    background: transparent;
    border-color: transparent;
  }
</style>
