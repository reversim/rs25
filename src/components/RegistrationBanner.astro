<div id="registration-banner" class="banner-container" style="display: none">
  <div class="banner-content">
    <div class="banner-message">
      <strong>Registration Opens September 3rd!</strong>
      <span
        >Get ready to secure your spot at Reversim Summit 2025. Stay tuned for
        more details</span
      >
    </div>
    <div class="banner-actions">
      <button id="never-show-again-btn" class="never-show-btn">
        Never show again
      </button>
      <button id="close-banner-btn" class="close-btn" aria-label="Close banner">
        Close
      </button>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const banner = document.getElementById("registration-banner");
    const closeBannerBtn = document.getElementById("close-banner-btn");
    const neverShowBtn = document.getElementById("never-show-again-btn");

    // Check if user has permanently dismissed the banner
    if (!localStorage.getItem("registration-banner-dismissed")) {
      banner?.style.removeProperty("display");
    }

    // Close banner temporarily
    closeBannerBtn?.addEventListener("click", () => {
      banner?.style.setProperty("display", "none");
    });

    // Never show again - store in localStorage
    neverShowBtn?.addEventListener("click", () => {
      localStorage.setItem("registration-banner-dismissed", "true");
      banner?.remove();
    });
  });
</script>

