---
import Title from "./title.astro";
import FrameEdge from "./frameEdge.astro";
---

<Title style="color: #060723" title="Venue" id="venue" />
<h4>Expo Tel Aviv Pavilion 10</h4>
<div class="venue">
  <div class="venue-info">
    <p class="descriptions">
      Formerly known as the Israel Trade Fairs and Convention Center and
      later the Tel Aviv Convention Center, and commonly referred to as Ganei
      HaTaarucha or the Tel Aviv Fairgrounds, Expo Tel Aviv is a fairground complex on Rokach
      Boulevard in northern Tel Aviv, Israel used as a venue for concerts,
      exhibitions, trade fairs and conferences.
    </p>
    <!-- <h4>How to get here?</h4>
    <p>
      Car
      <br />
      Bus
      <br />
      Train
      <br />
      AirPlain
      <br />
    </p>
    <h4>Kosher food</h4>
    <p>The 2024 site has a link to the thing here</p>
    <h4>Will there be real coffee?</h4>
    <p>Good Question!</p> -->
  </div>
  <div class="map-wrapper">
    <FrameEdge rotation={0} />
    <iframe
      title="google map to the conference venue"
      src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d6759.250612977819!2d34.810085!3d32.106411!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x151d497b83bbbbaf%3A0x5a59d2a2b6fee5ae!2sHall%2010!5e0!3m2!1sen!2sil!4v1755605843753!5m2!1sen!2sil"
      width="600"
      height="450"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    >
    </iframe>
    <FrameEdge bottom={0} right={0} rotation={180} />
  </div>
</div>

<style lang="scss">
  p {
    font-size: 16px;
  }

  h4 {
    font-size: 20px;
    font-weight: 500;
    margin-top: 20px;
  }

  .venue {
    display: flex;
    width: 100%;
    gap: 42px;
    align-items: start;
    > * {
      flex: 1;
    }

    @media screen and (max-width: 768px) {
      flex-direction: column;

      * {
        width: 100%;
      }
    }
  }
  .map-wrapper {
    position: relative;

    iframe {
      width: 100%;
    }
  }
</style>
