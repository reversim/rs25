---
import Twitter from "../assets/socials/x-twitter.svg";
import Linkedin from "../assets/socials/linkedin.svg";
import Bluesky from "../assets/socials/bluesky.svg";
import Facebook from "../assets/socials/facebook.svg";
import Github from "../assets/socials/github.svg";
import Instagram from "../assets/socials/instagram.svg";
import Link from "../assets/socials/link.svg";
import Medium from "../assets/socials/medium.svg";
import Youtube from "../assets/socials/youtube.svg";
import Sessionize from "../assets/socials/sessionize.svg";

interface Props {
  link?: string;
  type: string;
  variant?: "sponsor" | "member-large" | "member-medium";
}

const { link, type, variant } = Astro.props;
const iconsSize = variant === "member-medium" ? 20 : 24;
const lowerCaseType = type.toLowerCase();

const supportedTypes = [
  "linkedin",
  "twitter",
  "bluesky",
  "facebook",
  "github",
  "instagram",
  "website",
  "company_website",
  "medium",
  "youtube",
  "sessionize",
];
---

{
  link && supportedTypes.includes(lowerCaseType) && (
    <a class={`${variant} ${lowerCaseType}`} target="_blank" href={link}>
      {() => {
        switch (lowerCaseType) {
          case "linkedin":
            return <Linkedin width={iconsSize} />;

          case "twitter":
            return <Twitter width={iconsSize} />;

          case "bluesky":
            return <Bluesky width={iconsSize} />;

          case "facebook":
            return <Facebook width={iconsSize} />;

          case "github":
            return <Github width={iconsSize} />;

          case "instagram":
            return <Instagram width={iconsSize} />;

          case "website":
          case "company_website":
            return <Link width={iconsSize + 4} />;

          case "medium":
            return <Medium width={iconsSize} />;

          case "youtube":
            return <Youtube width={iconsSize} />;
          case "sessionize":
            return <Sessionize width={iconsSize} />;

          default:
            return <Link width={iconsSize + 4} />;
        }
      }}
    </a>
  )
}

<style lang="scss">
  a {
    border-radius: 50%;
    aspect-ratio: 1;
    width: 28px;

    display: flex;
    justify-content: center;
    align-items: center;

    svg {
      fill: #cddcf0;
      transition: 0.3s;
    }

    &:hover {
      svg {
        fill: white;
      }
    }

    &.member-large,
    &.member-medium {
      svg {
        fill: black;
      }

      &:hover {
        svg {
          fill: var(--dark-gray);
        }
      }
    }
  }
</style>
