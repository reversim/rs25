---
import {
  getTrackName,
  type AgendaDay,
  type AgendaSession,
} from "../../helpers/getAgenda";

interface Props {
  currentDay: AgendaDay;
}
const { currentDay } = Astro.props;

// Extract all sessions for filtering (from current day only)
const allSessions: AgendaSession[] = currentDay.rooms.flatMap(
  (room) => room.sessions,
);

// Extract unique rooms and categories for filters
const uniqueRooms = [
  ...new Set(currentDay.rooms.map((room) => room.name)),
].sort();

const uniqueCategories = [
  ...new Set(
    allSessions.flatMap((session) => {
      const track = getTrackName(session);
      return track ? [track] : [];
    }),
  ),
].sort();
---

<!-- TODO Filter Toggle Button -->
<div class="filter-toggle-container">
  <button class="filter-toggle-btn" onclick="toggleFilters()">
    <span class="filter-icon">🔍</span>
    Filters
    <span class="filter-arrow">▼</span>
  </button>
</div>

<!-- Filter Section -->
<div class="filter-section" id="filter-section" style="display: none;">
  <div class="filter-grid">
    <div class="filter-column">
      <h4>Theme</h4>
      <div class="filter-options" id="theme-filters">
        {
          uniqueCategories.map((category) => (
            <label class="filter-checkbox">
              <input
                type="checkbox"
                value={category}
                onchange="applyFilters()"
              />
              <span class="checkmark" />
              {category}
            </label>
          ))
        }
      </div>
    </div>

    <div class="filter-column">
      <h4>Rooms</h4>
      <div class="filter-options" id="room-filters">
        {
          uniqueRooms.map((room) => (
            <label class="filter-checkbox">
              <input type="checkbox" value={room} onchange="applyFilters()" />
              <span class="checkmark" />
              {room}
            </label>
          ))
        }
      </div>
    </div>
  </div>

  <div class="filter-footer">
    <button class="reset-filters-btn" onclick="clearAllFilters()">Reset</button>
  </div>
</div>

<script is:inline define:vars={{ allSessions }}>
  // Pass sessions data to the client-side script
  const sessionsData = allSessions;

  // Helper functions for client-side use
  const getSessionTrackName = (session) => {
    const trackCategory = session.categories?.find((c) => c.name === "Track");
    const item = trackCategory?.categoryItems?.[0];
    if (!item) return null;
    const raw = item.name;
    if (raw === "AI Apps" || raw === "AI Infra") return "AI";
    return raw;
  };

  const findSessionById = (sessionId) => {
    return sessionsData.find((session) => session.id === sessionId);
  };

  // Filtering Functions
  function applyFilters() {
    // Get all selected values from checkboxes
    const selectedThemes = Array.from(
      document.querySelectorAll("#theme-filters input:checked"),
    ).map((cb) => cb.value);
    const selectedRooms = Array.from(
      document.querySelectorAll("#room-filters input:checked"),
    ).map((cb) => cb.value);

    // Filter desktop cards (including lightning talk cards)
    const desktopCards = document.querySelectorAll(".session-content");
    const desktopBreaks = document.querySelectorAll(".break-session-content");
    const desktopBreakCells = document.querySelectorAll(".break-session-cell");

    // Filter mobile cards (including lightning talk cards)
    const mobileCards = document.querySelectorAll(".session-card");

    let visibleCount = 0;
    let totalCount = 0;

    // Apply filters to desktop session cards
    [...desktopCards, ...desktopBreaks].forEach((card) => {
      const sessionId = card.getAttribute("data-talk-id");
      const session = findSessionById(sessionId);

      if (session) {
        totalCount++;

        // Check theme match
        const track = getSessionTrackName(session);
        const matchesTheme =
          selectedThemes.length === 0 ||
          (track && selectedThemes.includes(track));

        // Check room match
        const matchesRoom =
          selectedRooms.length === 0 || selectedRooms.includes(session.room);

        if (matchesTheme && matchesRoom) {
          card.style.opacity = "1";
          card.style.transform = "scale(1)";
          card.style.transition = "all 0.3s ease";
          visibleCount++;
        } else {
          card.style.opacity = "0.1";
          card.style.transform = "scale(0.95)";
          card.style.transition = "all 0.3s ease";
        }
      }
    });

    // Apply filters to desktop full-width break session cells
    desktopBreakCells.forEach((cell) => {
      const sessionId = cell.getAttribute("data-talk-id");
      const session = findSessionById(sessionId);

      if (session) {
        totalCount++;

        // Check theme match
        const track = getSessionTrackName(session);
        const matchesTheme =
          selectedThemes.length === 0 ||
          (track && selectedThemes.includes(track));

        // Check room match
        const matchesRoom =
          selectedRooms.length === 0 || selectedRooms.includes(session.room);

        // Apply visual changes to the content only (like regular session cards)
        const breakContent = cell.querySelector(".break-session-content");
        if (breakContent) {
          if (matchesTheme && matchesRoom) {
            breakContent.style.opacity = "1";
            breakContent.style.transform = "scale(1)";
            breakContent.style.transition = "all 0.3s ease";
            visibleCount++;
          } else {
            breakContent.style.opacity = "0.1";
            breakContent.style.transform = "scale(0.95)";
            breakContent.style.transition = "all 0.3s ease";
          }
        }
      }
    });

    // Apply filters to mobile session cards
    mobileCards.forEach((card) => {
      const sessionId = card.getAttribute("data-talk-id");
      const session = findSessionById(sessionId);

      if (session) {
        const track = getSessionTrackName(session);
        const matchesTheme =
          selectedThemes.length === 0 ||
          (track && selectedThemes.includes(track));
        const matchesRoom =
          selectedRooms.length === 0 || selectedRooms.includes(session.room);

        if (matchesTheme && matchesRoom) {
          card.style.opacity = "1";
          card.style.transform = "scale(1)";
          card.style.transition = "all 0.3s ease";
        } else {
          card.style.opacity = "0.1";
          card.style.transform = "scale(0.95)";
          card.style.transition = "all 0.3s ease";
        }
      }
    });
  }

  function clearAllFilters() {
    // Uncheck all checkboxes
    document
      .querySelectorAll('.filter-section input[type="checkbox"]')
      .forEach((checkbox) => {
        checkbox.checked = false;
      });

    // Reset all cards to visible
    const allCards = document.querySelectorAll(
      ".session-content, .break-session-content, .break-session, .session-card",
    );
    allCards.forEach((card) => {
      card.style.opacity = "1";
      card.style.transform = "scale(1)";
      card.style.transition = "all 0.3s ease";
    });

    // Filters cleared successfully
  }

  // Filter Toggle Function
  function toggleFilters() {
    const filterSection = document.getElementById("filter-section");
    const toggleBtn = document.querySelector(".filter-toggle-btn");

    if (filterSection.style.display === "none") {
      filterSection.style.display = "block";
      toggleBtn.classList.add("active");
    } else {
      filterSection.style.display = "none";
      toggleBtn.classList.remove("active");
    }
  }

  // Make functions globally available
  window.applyFilters = applyFilters;
  window.clearAllFilters = clearAllFilters;
  window.toggleFilters = toggleFilters;
</script>

<style lang="scss">
  /* Filter Section Styles */
  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Filter Toggle Button */
  .filter-toggle-container {
    display: flex;
    justify-content: flex-end;
    margin: 16px 0;
  }

  .filter-toggle-btn {
    background: var(--pink);
    color: white;
    border: 2px solid var(--pink);
    border-radius: 25px;
    padding: 12px 24px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(253, 106, 130, 0.3);

    &:hover {
      background: #e05574;
      border-color: #e05574;
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(253, 106, 130, 0.4);
    }

    .filter-icon {
      font-size: 18px;
    }

    .filter-arrow {
      font-size: 12px;
      transition: transform 0.3s ease;
    }

    &.active {
      background: #e05574;
      border-color: #e05574;

      .filter-arrow {
        transform: rotate(180deg);
      }
    }
  }

  .filter-section {
    background: white;
    border: 2px solid #e5e7eb;
    border-radius: 16px;
    padding: 16px 24px;
    margin: 16px 0 24px 0;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    animation: slideDown 0.3s ease-out;
  }

  .filter-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 32px;
    margin-bottom: 12px;
  }

  .filter-column {
    display: flex;
    flex-direction: column;

    h4 {
      font-size: 18px;
      font-weight: 700;
      color: #374151;
      margin: 0 0 16px 0;
      padding-bottom: 8px;
      border-bottom: 2px solid #f3f4f6;
    }
  }

  .filter-options {
    display: flex;
    flex-direction: column;
  }

  .filter-checkbox {
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    padding: 8px 0;
    font-size: 15px;
    color: #6b7280;
    font-weight: 500;
    transition: color 0.2s ease;

    &:hover {
      color: #374151;
    }

    input[type="checkbox"] {
      position: absolute;
      opacity: 0;
      cursor: pointer;
      height: 0;
      width: 0;
    }

    .checkmark {
      height: 20px;
      width: 20px;
      background-color: #f9fafb;
      border: 2px solid #d1d5db;
      border-radius: 4px;
      position: relative;
      transition: all 0.2s ease;
    }

    &:hover .checkmark {
      border-color: var(--pink);
      background-color: #fef7f7;
    }

    input:checked ~ .checkmark {
      background-color: var(--pink);
      border-color: var(--pink);
    }

    .checkmark:after {
      content: "";
      position: absolute;
      display: none;
      left: 6px;
      top: 2px;
      width: 6px;
      height: 10px;
      border: solid white;
      border-width: 0 2px 2px 0;
      transform: rotate(45deg) translateX(-3px);
    }

    input:checked ~ .checkmark:after {
      display: block;
    }
  }

  .filter-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 16px;
    border-top: 1px solid #e5e7eb;
    flex-wrap: wrap;
    gap: 16px;
  }

  .reset-filters-btn {
    background: transparent;
    color: var(--pink);
    border: 2px solid var(--pink);
    border-radius: 25px;
    padding: 10px 24px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;

    &:hover {
      background: var(--pink);
      color: white;
      transform: translateY(-1px);
    }
  }

  @media (max-width: 768px) {
    .filter-toggle-container {
      justify-content: center;
      margin: 16px 0;
    }

    .filter-toggle-btn {
      padding: 14px 28px;
      font-size: 18px;
    }

    .filter-section {
      padding: 24px 20px;
      margin: 16px 0;
    }

    .filter-grid {
      grid-template-columns: 1fr;
      gap: 24px;
      margin-bottom: 12px;
    }

    .filter-column {
      h4 {
        font-size: 16px;
        margin-bottom: 12px;
      }
    }

    .filter-checkbox {
      padding: 12px 0;
      font-size: 16px;

      .checkmark {
        height: 22px;
        width: 22px;
      }

      .checkmark:after {
        left: 7px;
        top: 3px;
        width: 6px;
        height: 10px;
      }
    }

    .filter-footer {
      flex-direction: column;
      gap: 16px;
      padding-top: 16px;
      align-items: stretch;
    }

    .reset-filters-btn {
      width: 100%;
      padding: 14px 24px;
      font-size: 16px;
    }
  }
</style>
