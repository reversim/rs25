---
import { formatTime } from "../../../helpers/agendaHelpers";
import type { CurrentDay } from "../../../helpers/getAgenda";
import SessionCard from "./sessionCard.astro";

interface Props {
  currentDay: CurrentDay;
}
const { currentDay } = Astro.props;
---

<div class="agenda-main agenda-container mobile-only">
  <div class="day-section active">
    <div class="day-header">{currentDay.label}</div>
    {
      currentDay.grid.map((row, rowIndex) => (
        <div
          class="time-slot-container"
          id={`time-slot-mobile-${currentDay.slug}-${rowIndex}`}
        >
          <div class="time-header">{formatTime(row.startsAt)}</div>
          <SessionCard session={row.cells} />
        </div>
      ))
    }
  </div>
</div>

<style lang="scss">
  /* Switch to desktop layout */
  @media (min-width: 768px) {
    .agenda-container {
      display: none;
    }
  }

  .day-header {
    position: sticky;
    top: var(--header-height);
    z-index: 2;
    height: 44px;

    background: linear-gradient(135deg, #e3f2fd, #bbdefb);
    color: white;
    font-size: 16px;
    font-weight: 600;
    text-align: center;
    border-radius: 12px 12px 0 0;
    margin-bottom: 20px;
    padding: 12px 20px;

    animation: shrinkRadius 0.5s both;
    animation-timeline: scroll(root block);
    animation-range-start: 0;
    animation-range-end: 100dvh;
  }

  @keyframes shrinkRadius {
    from {
      border-radius: 5px;
    }
    to {
      border-radius: 0px;
    }
  }

  .time-slot-container {
    margin-bottom: 30px;

    &:last-child {
      margin-bottom: 0;
    }

    .time-header {
      font-size: 20px;
      font-weight: 700;
      color: #2c3e50;
      margin-bottom: 15px;
      padding-left: 5px;
    }
  }
</style>
