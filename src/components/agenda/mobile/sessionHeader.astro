---
import { formatTime } from "../../../helpers/agendaHelpers";
import Category from "../category.astro";
import LikeTalkButton from "../likeTalkButton.astro";

interface Props {
  sessionStartsAt: string;
  duration: number;
  sessionRoom?: string;
  sessionId: string | number;
  isSession: boolean;
}
const {
  sessionRoom,
  sessionStartsAt,
  duration,
  sessionId,
  isSession,
} = Astro.props;
---

<div class="session-header">
  <Category uppercase={false} categoryColor={"#506592"} track={sessionRoom} />
  <span class="time-duration">
    {formatTime(sessionStartsAt)}
    {" "}
    → {duration} min
  </span>
  {isSession ? <LikeTalkButton sessionId={sessionId} /> : <div />}
</div>

<style lang="scss">
  .session-header {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 15px;

    .time-duration {
      font-size: 13px;
      color: var(--secondary-text-color);
      font-weight: 500;
    }
  }
</style>
