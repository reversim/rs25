---
import {
  agendaSessionAnalytics,
  createSessionUrl,
  getSessionDuration,
  getTalkCategoryColor,
} from "../../../helpers/agenda/agendaHelpers";
import { getTrackName } from "../../../helpers/data/getAgenda";
import type { AgendaSession, Cell } from "../../../types/agenda";
import Category from "../category.astro";
import SessionCategoryIndicator from "../sessionCategoryIndicator.astro";
import SessionSpeakers from "../sessionSpeakers.astro";
import LightningTalkMobile from "./lightningTalkMobile.astro";
import SessionCardHeader from "./sessionHeader.astro";
interface Props {
  session: Cell[];
}
const { session: sessions } = Astro.props;
---

<div class="sessions-container">
  {
    sessions
      .filter((cell) => cell.session && !cell.hidden)
      .map((cell, cellIndex) => {
        const session = cell.session! as AgendaSession;
        const isSession =
          !session.isServiceSession || session.room === "Main hall";

        const duration = getSessionDuration(session.startsAt, session.endsAt);

        const categoryColor = getTalkCategoryColor(session);

        // If this is a service session (break), create non-interactive card
        if (session.isServiceSession) {
          return (
            <div
              class="session-card break-session-mobile"
              data-talk-id={session.id}
            >
              <SessionCardHeader
                sessionRoom={session.room}
                sessionStartsAt={session.startsAt}
                duration={duration}
                session={session}
                isSession={isSession}
              />
              <h3 class="session-title break-title-mobile">{session.title}</h3>

              <SessionCategoryIndicator categoryColor={categoryColor} />
            </div>
          );
        }

        // If this is a lightning group, create one card with all lightning talks
        if (session.isLightningGroup && session.lightningChildren) {
          return (
            <div
              class="session-card lightning-group-mobile"
              data-talk-id={session.id}
            >
              <SessionCardHeader
                sessionRoom={session.lightningChildren[0]?.room}
                sessionStartsAt={session.startsAt}
                duration={duration}
                session={session}
                isSession={isSession}
              />

              <h3 class="session-title">Ignites sessions</h3>
              <LightningTalkMobile lightnings={session.lightningChildren} />

              <SessionCategoryIndicator categoryColor={categoryColor} />
            </div>
          );
        }

        // Regular session card
        return (
          <div class="session-card" data-talk-id={session.id}>
            <SessionCardHeader
              sessionRoom={session.room}
              sessionStartsAt={session.startsAt}
              duration={duration}
              session={session}
              isSession={isSession}
            />

            <h3 class="session-title">
              <a
                href={createSessionUrl(session.title)}
                {...agendaSessionAnalytics(session.title)}
              >
                {session.title}
              </a>
            </h3>
            <SessionSpeakers speakers={session.speakers} />

            <Category
              categoryColor={categoryColor}
              track={getTrackName(session)}
              style="margin-top: 10px"
            />

            <SessionCategoryIndicator categoryColor={categoryColor} />
          </div>
        );
      })
  }
</div>

<style lang="scss">
  .sessions-container {
    display: flex;
    flex-direction: column;
    gap: 15px;

    .session-card {
      user-select: none;
      -webkit-user-select: none;
      -moz-user-select: none;
      -ms-user-select: none;
      cursor: default;
      padding: 16px;
      background: var(--rs26-panel-2);
      border: 1px solid var(--rs26-navy-line);
      border-radius: 12px;
      position: relative;
      transition: all 0.3s var(--rs26-ease);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);

      &:hover {
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3) !important;
        border-color: var(--rs26-navy-line) !important;
      }

      &:focus {
        outline: none;
        transform: none !important;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3) !important;
        border-color: var(--rs26-navy-line) !important;
      }

      &:active {
        transform: none !important;
      }
    }

    .session-title {
      font-family: var(--rs26-display);
      font-size: 18px;
      padding-right: 35px;
      line-height: 1.3;
      margin: 0 0 12px 0;
      color: var(--rs26-white);
    }
  }
</style>
