---
import { getSessionUrl } from "../../../helpers/agendaHelpers";
import type { AgendaSession } from "../../../helpers/getAgenda";
import SessionSpeakers from "../sessionSpeakers.astro";

interface Props {
  lightnings: AgendaSession[];
}
const { lightnings } = Astro.props;
---

<div class="lightning-talks-mobile-list">
  {
    lightnings.map((child: AgendaSession) => (
      <div class="lightning-talk-item-mobile">
        <h4 class="lightning-talk-title-mobile">
          <a href={getSessionUrl(child)}>{child.title}</a>
        </h4>
        <SessionSpeakers speakers={child.speakers} />
      </div>
    ))
  }
</div>

<style lang="scss">
  .lightning-talks-mobile-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .lightning-talk-item-mobile {
    padding: 12px;
    background: #f8f9fa;
    border-radius: 8px;
  }

  .lightning-talk-title-mobile {
    font-size: 15px;
    font-weight: 600;
    margin: 0 0 8px 0;
    line-height: 1.3;

    a {
      color: #2c3e50;
      text-decoration: none;

      &:hover {
        color: var(--blue);
        text-decoration: underline;
      }
    }
  }
</style>
