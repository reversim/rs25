---
import {
  agendaSessionAnalytics,
  createSessionUrl,
} from "../../../helpers/agenda/agendaHelpers";
import type { AgendaSession } from "../../../types/agenda";
import SessionSpeakers from "../sessionSpeakers.astro";

interface Props {
  lightnings: AgendaSession[];
}
const { lightnings } = Astro.props;
---

<div class="lightning-talks-mobile-list">
  {
    lightnings.map((session: AgendaSession) => (
      <div class="lightning-talk-item-mobile">
        <h4 class="lightning-talk-title-mobile">
          <a
            href={createSessionUrl(session.title)}
            {...agendaSessionAnalytics(session.title)}
          >
            {session.title}
          </a>
        </h4>
        <SessionSpeakers speakers={session.speakers} />
      </div>
    ))
  }
</div>

<style lang="scss">
  .lightning-talks-mobile-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .lightning-talk-item-mobile {
    padding: 12px;
    background: var(--rs26-navy-2);
    border: 1px solid var(--rs26-navy-line);
    border-radius: var(--rs26-r-sm);
  }

  .lightning-talk-title-mobile {
    font-size: 15px;
    font-weight: 600;
    margin: 0 0 8px 0;
    line-height: 1.3;

    a {
      color: var(--rs26-white);
      text-decoration: none;

      &:hover {
        color: var(--rs26-blue-bright);
        text-decoration: underline;
      }
    }
  }
</style>
