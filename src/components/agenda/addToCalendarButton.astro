---
import type { AgendaSession } from "../../types/agenda";
import type { CalendarSessionData } from "../../types/calendar";
import Calendar from "../../assets/agenda/calendar.svg";

interface Props {
  session: AgendaSession;
}

const { session } = Astro.props;

// Extract only the fields needed for calendar functionality
const calendarData: CalendarSessionData = {
  id: session.id,
  title: session.title,
  startsAt: session.startsAt,
  endsAt: session.endsAt,
  room: session.room,
  speakers: session.speakers,
  description: session.description,
};

const sessionData = JSON.stringify(calendarData);
---

<div class={`add-to-calendar-wrapper`}>
  <button
    class="add-to-calendar-btn"
    data-session={sessionData}
    aria-label={`Add ${session.title} to calendar`}
    aria-expanded="false"
  >
    <Calendar />
  </button>

  <div class="calendar-dropdown">
    <button class="calendar-option google"> Google </button>
    <button class="calendar-option outlook"> Outlook </button>
    <button class="calendar-option yahoo"> Yahoo </button>
    <button class="calendar-option ical"> Apple/iCal (.ics) </button>
  </div>
</div>

<script>
  import {
    createGoogleCalendarUrl,
    createOutlookCalendarUrl,
    createYahooCalendarUrl,
    createICalContent,
  } from "../../helpers/agenda/addToCalendar";
  import type { CalendarSessionData } from "../../types/calendar";

  function closeDropdown(dropdown: Element) {
    dropdown.classList.remove("show");
    dropdown
      .closest(".add-to-calendar-wrapper")
      ?.querySelector(".add-to-calendar-btn")
      ?.setAttribute("aria-expanded", "false");
  }

  function setupAddToCalendar() {
    const buttons = document.querySelectorAll(".add-to-calendar-btn");

    buttons.forEach((button) => {
      const sessionData = button.getAttribute("data-session");
      if (!sessionData) return;

      const session: CalendarSessionData = JSON.parse(sessionData);
      const wrapper = button.closest(".add-to-calendar-wrapper");
      const dropdown = wrapper?.querySelector(".calendar-dropdown");

      // Toggle dropdown
      button.addEventListener("click", (e) => {
        e.stopPropagation();
        const isOpen = dropdown?.classList.toggle("show") ?? false;
        button.setAttribute("aria-expanded", String(isOpen));

        // Close other dropdowns
        document.querySelectorAll(".calendar-dropdown.show").forEach((d) => {
          if (d !== dropdown) closeDropdown(d);
        });
      });

      // Handle calendar option clicks
      const options = dropdown?.querySelectorAll(".calendar-option");
      options?.forEach((option) => {
        option.addEventListener("click", (e) => {
          e.stopPropagation();
          const calendarType = option.classList[1]; // google, outlook, yahoo, or ical

          let url: string;
          switch (calendarType) {
            case "google":
              url = createGoogleCalendarUrl(session);
              window.open(url, "_blank");
              break;
            case "outlook":
              url = createOutlookCalendarUrl(session);
              window.open(url, "_blank");
              break;
            case "yahoo":
              url = createYahooCalendarUrl(session);
              window.open(url, "_blank");
              break;
            case "ical":
              // Download .ics file
              const icalContent = createICalContent(session);
              const blob = new Blob([icalContent], { type: "text/calendar" });
              const downloadUrl = URL.createObjectURL(blob);
              const a = document.createElement("a");
              a.href = downloadUrl;
              a.download = `${session.title.replace(/[^a-z0-9]/gi, "_")}.ics`;
              a.click();
              URL.revokeObjectURL(downloadUrl);
              break;
          }

          if (dropdown) closeDropdown(dropdown);
        });
      });
    });

    // Close dropdown when clicking outside
    document.addEventListener("click", () => {
      document
        .querySelectorAll(".calendar-dropdown.show")
        .forEach(closeDropdown);
    });
  }

  // Run on page load
  setupAddToCalendar();

  // Re-run after navigation (for SPA-like behavior)
  document.addEventListener("astro:page-load", setupAddToCalendar);
</script>

<style lang="scss">
  .add-to-calendar-wrapper {
    position: relative;
    display: inline-block;

    svg {
      width: 20px;
      height: 20px;
      transition: all 0.2s ease;
    }

    @media screen and (min-width: 768px) {
      &:hover {
        svg {
          stroke: var(--rs26-blue-bright);
        }
      }
    }
  }

  .add-to-calendar-btn {
    display: flex;
    align-items: center;
    color: var(--rs26-muted-3);
    background: none;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    outline: none;

    .chevron {
      margin-left: auto;
      transition: transform 0.2s ease;
    }
  }

  .add-to-calendar-wrapper:has(.calendar-dropdown.show) {
    .chevron {
      transform: rotate(180deg);
    }
  }

  .calendar-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    background: var(--rs26-panel-2);
    border: 1px solid var(--rs26-navy-line);
    border-radius: 8px;
    box-shadow:
      0 4px 6px rgba(0, 0, 0, 0.3),
      0 10px 20px rgba(0, 0, 0, 0.4);
    min-width: 160px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.2s ease;
    z-index: 1000;

    &.show {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
  }

  .calendar-option {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 12px 16px;
    background: var(--rs26-panel-2);
    border: none;
    text-align: left;
    font-size: 14px;
    color: var(--rs26-text);
    cursor: pointer;
    transition: background 0.2s ease;

    &:first-child {
      border-radius: 8px 8px 0 0;
    }

    &:last-child {
      border-radius: 0 0 8px 8px;
    }

    &:not(:last-child) {
      border-bottom: 1px solid var(--rs26-navy-line);
    }

    &:hover {
      background: rgba(108, 140, 199, 0.12);
    }
  }
</style>
