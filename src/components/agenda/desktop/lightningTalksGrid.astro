---
import {
  agendaSessionAnalytics,
  createSessionUrl,
  createSpeakerUrl,
} from "../../../helpers/agenda/agendaHelpers";
import type { AgendaSession, AgendaSpeaker } from "../../../types/agenda";
const { lightningArr } = Astro.props;
---

<div class="lightning-talk-list">
  {
    lightningArr?.map((session: AgendaSession) => {
      return (
        <div class="lightning-talk-container">
          <a
            class="lightning-talk-title"
            href={createSessionUrl(session.title)}
            {...agendaSessionAnalytics(session.title)}
          >
            {session.title}
          </a>
          {session.speakers.length > 0 &&
            session.speakers.map((speaker: AgendaSpeaker) => (
              <a
                class="lightning-speaker"
                href={createSpeakerUrl(speaker?.name || "")}
              >
                {speaker.name}
              </a>
            ))}
        </div>
      );
    })
  }
</div>

<style lang="scss">
  .lightning-talk-list {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    font-size: 14px;
    margin-top: 10px;

    .lightning-talk-container {
      .lightning-talk-title {
        font-weight: 700;
        color: var(--rs26-white);

        &:hover {
          color: var(--rs26-blue-bright);
          text-decoration: underline;
        }
      }

      .lightning-speaker {
        color: var(--rs26-muted);

        &:hover {
          color: var(--rs26-blue-bright);
          text-decoration: underline;
        }
      }
    }
  }
</style>
