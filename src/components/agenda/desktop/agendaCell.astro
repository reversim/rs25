---
import {
  agendaSessionAnalytics,
  createSessionUrl,
  getSessionDuration,
  getTalkCategoryColor,
  getTrackName,
} from "../../../helpers/agenda/agendaHelpers";
import type { Cell, CurrentDay } from "../../../types/agenda";
import SessionCategory from "../category.astro";
import LikeTalkButton from "../likeTalkButton.astro";
import SessionCategoryIndicator from "../sessionCategoryIndicator.astro";
import SessionSpeakers from "../sessionSpeakers.astro";
import TalkActions from "../talkActions.astro";
interface Props {
  cells: Cell[];
  currentDay: CurrentDay;
  desiredRooms: string[];
}
const { cells, currentDay, desiredRooms } = Astro.props;
---

{
  cells.map((cell, cellIndex) => {
    // Skip cells that are marked as hidden (e.g., spanned cells)
    if (cell.hidden) return null;

    // Find which room this cell index corresponds to
    const roomForCell = currentDay.rooms[cellIndex];

    if (!roomForCell)
      return <div class="empty-cell" style={`--col-index: ${cellIndex + 2}`} />;

    // Check if this room is one of our desired rooms
    const roomIndex = desiredRooms.indexOf(roomForCell.name);
    if (roomIndex === -1) return null; // Skip rooms not in our desired list

    // If no session in this cell, render empty cell
    if (!cell.session) {
      return <div class="empty-cell" style={`--col-index: ${roomIndex + 2}`} />;
    }

    const session = cell.session;

    const duration = getSessionDuration(session.startsAt, session.endsAt);
    const categoryColor = getTalkCategoryColor(session);
    const track = getTrackName(session);

    return (
      <div
        class="session-cell"
        style={`--col-index: ${roomIndex + 2}`}
        onclick="if (!event.target.closest('a, button')) this.querySelector('.session-title a').click()"
      >
        <div class="session-content" data-talk-id={session.id}>
          <div class="session-duration">{duration} minutes</div>
          <h3 class="session-title">
            <a
              href={createSessionUrl(session.title)}
              {...agendaSessionAnalytics(session.title)}
            >
              {session.title}
            </a>
          </h3>
          <SessionSpeakers speakers={session.speakers} />
          <SessionCategory track={track} categoryColor={categoryColor} />
          <TalkActions session={session} />
          <SessionCategoryIndicator categoryColor={categoryColor} />
        </div>
      </div>
    );
  })
}

<style lang="scss">
  .empty-cell {
    background: var(--rs26-navy-2);
    border-right: 1px solid var(--rs26-navy-line);
    grid-column: var(--col-index);

    &:last-child {
      border-right: none;
    }
  }

  .session-cell {
    padding: 8px;
    vertical-align: top;
    border-right: 1px solid var(--rs26-navy-line);
    z-index: 1;
    grid-column: var(--col-index);

    &:last-child {
      border-right: none;
    }

    .session-content {
      height: 100%;
      background: var(--rs26-panel-2);
      border: 1px solid var(--rs26-navy-line);
      border-radius: var(--rs26-r-sm);
      padding: 15px;

      cursor: pointer;
      position: relative;
      transition: all 0.3s var(--rs26-ease);
      display: flex;
      flex-direction: column;
      min-height: 120px;

      &:hover {
        transform: translateY(-2px);
        box-shadow: 0 24px 40px -28px rgba(0, 0, 0, 0.9);
        border-color: var(--rs26-blue);
      }

      .session-duration {
        font-family: var(--rs26-mono);
        font-size: 12px;
        color: var(--rs26-blue-bright);
        font-weight: 500;
        margin-bottom: 8px;
      }

      .session-title {
        font-family: var(--rs26-display);
        font-size: 20px;
        font-weight: 600;
        line-height: 1.3;
        margin: 0 0 12px 0;
        color: var(--rs26-white);
        padding-right: 40px;

        a {
          color: inherit;
          text-decoration: none;

          &:hover {
            color: var(--rs26-blue-bright);
            text-decoration: underline;
          }
        }
      }
    }
  }
</style>
