---
interface Props {
  dayLabel: string;
  desiredRooms: string[];
}
const { dayLabel, desiredRooms } = Astro.props;
---

<div class="schedule-header">{dayLabel}</div>
<div class="grid-header">
  <div class="time-column-header">Time</div>
  {
    desiredRooms.map((roomName) => (
      <div class="room-column-header">{roomName}</div>
    ))
  }
</div>

<style lang="scss">
  .schedule-header {
    background: linear-gradient(135deg, #e3f2fd, #bbdefb);
    height: 54px;
    color: var(--blue);
    padding: 15px 25px;
    font-weight: 600;
    text-align: center;
    border-radius: 12px 12px 0 0;
    font-size: 18px;

    position: sticky;
    top: var(--header-height);
    z-index: 2;
  }

  .grid-header {
    display: grid;
    grid-template-columns: 120px 1fr 1fr 1fr;
    background: #f8f9fa;
    border-bottom: 2px solid #e9ecef;
    position: sticky;
    top: calc(var(--header-height) + 54px);
    z-index: 3;

    .time-column-header,
    .room-column-header {
      padding: 15px 20px;
      text-align: center;
      font-weight: 700;
      color: var(--blue);
      border-right: 1px solid #e9ecef;

      &:last-child {
        border-right: none;
      }
    }

    .time-column-header {
      width: 120px;
      min-width: 120px;
      background: #f1f3f4;
    }

    .room-column-header {
      width: 100%;
      min-width: 200px;
    }
  }
</style>
