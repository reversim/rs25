---
const { currentDay, rowIndex, row, session, track, duration } = Astro.props;

import {
  createSessionUrl,
  formatTime,
  getTalkCategoryColor,
} from "../../../helpers/agenda/agendaHelpers";
import SessionCategory from "../category.astro";
import LikeTalkButton from "../likeTalkButton.astro";
import SessionCategoryIndicator from "../sessionCategoryIndicator.astro";
import SessionSpeakers from "../sessionSpeakers.astro";
import TalkActions from "../talkActions.astro";
import LightningTalkList from "./lightningTalksGrid.astro";
import TimeColumn from "./timeColumn.astro";

const isSession =
  session.isLightningGroup ||
  track === "Keynote" ||
  session.title === "Opening Words";
---

<div
  class="time-slot-row full-width-row"
  id={`time-slot-${currentDay.slug}-${rowIndex}`}
  role="group"
  aria-label={`Sessions at ${formatTime(row.startsAt)}`}
>
  <TimeColumn
    highlighted={session.room === "Dining Hall"}
    startsAt={row.startsAt}
    endsAt={row.endsAt}
  />
  <div
    class="full-width-session-cell"
    data-talk-id={session.id}
    onclick={track === "Keynote"
      ? `window.location.href='${createSessionUrl(session.title)}'`
      : null}
  >
    <div
      class={`full-width-session-content ${session.room === "Dining Hall" ? "highlighted" : "session-content"}`}
    >
      <div class="break-time">{duration} minutes</div>

      <SessionCategoryIndicator categoryColor={getTalkCategoryColor(session)} />
      {
        track !== "Keynote" && !session.isLightningGroup ? (
          <>
            <h3 class="break-title">{session.title}</h3>
            <div class="break-location">{session.room}</div>
          </>
        ) : (
          <div />
        )
      }
      {isSession ? <TalkActions session={session} /> : <div />}
      {
        session.isLightningGroup && (
          <>
            <h3 class="break-title">Ignites sessions</h3>
            <div class="break-location">
              {session?.lightningChildren?.[0]?.room}
            </div>

            <LightningTalkList lightningArr={session.lightningChildren} />
          </>
        )
      }
      {
        track === "Keynote" && (
          <div class="keynote-session">
            <a class="break-title" href={createSessionUrl(session.title)}>
              {session.title}
            </a>
            <SessionSpeakers speakers={session.speakers} />
            <div class="break-location">{session.room}</div>
          </div>
        )
      }

      <SessionCategory
        categoryColor={getTalkCategoryColor(session)}
        track={track}
      />
    </div>
  </div>
</div>

<style lang="scss">
  a {
    color: inherit;
    text-decoration: none;

    &:hover {
      color: var(--rs26-blue-bright);
      text-decoration: underline;
    }
  }

  .session-content {
    height: 100%;
    background: var(--rs26-panel-2);
    border: 1px solid var(--rs26-navy-line);
    border-radius: var(--rs26-r-sm);
    padding: 15px;

    cursor: pointer;
    position: relative;
    transition: all 0.3s var(--rs26-ease);
    display: flex;
    flex-direction: column;
    min-height: 120px;

    &:hover {
      transform: translateY(-2px);
      box-shadow: 0 24px 40px -28px rgba(0, 0, 0, 0.9);
      border-color: var(--rs26-blue);
    }
  }

  .time-slot-row {
    display: grid;
    grid-template-columns: 120px 1fr 1fr 1fr;
    border-bottom: 1px solid var(--rs26-navy-line);

    &:last-child {
      border-bottom: none;
    }

    &.full-width-row {
      grid-template-columns: 120px 1fr;

      .full-width-session-cell {
        grid-column: 2;
        padding: 8px;
        border-right: 1px solid var(--rs26-navy-line);

        &:last-child {
          border-right: none;
        }

        // Lift the row whose calendar menu is open: otherwise the next row
        // paints over the part of the menu hanging below this one.
        &:has(:global(.calendar-dropdown.show)) {
          z-index: 2;
        }
      }
    }

    .full-width-session-content {
      padding: 20px;
      text-align: center;
      cursor: pointer;
      transition: all 0.3s var(--rs26-ease);
      border-radius: var(--rs26-r-sm);
      color: var(--rs26-muted);

      &:hover {
        transform: translateY(-1px);
        box-shadow: 0 16px 30px -24px rgba(0, 0, 0, 0.9);
        border-color: var(--rs26-blue);
        z-index: 1;
      }

      .break-time {
        font-family: var(--rs26-mono);
        font-size: 12px;
        font-weight: 500;
      }

      .break-title {
        font-family: var(--rs26-display);
        font-size: 24px;
        font-weight: 600;
        color: var(--rs26-white);
        margin: 0;
      }

      .break-location {
        font-family: var(--rs26-mono);
        font-size: 13px;
        font-weight: 400;
        color: var(--rs26-muted);
      }

      .keynote-session {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;

        a {
          width: max-content;
        }
      }
    }

    &:has(.highlighted) {
      background: var(--rs26-navy-2);
      .time-column,
      .full-width-session-cell {
        background: none;
        border: none;
      }

      .full-width-session-content {
        border: none;
        background: none;

        &:hover {
          background: none;
          box-shadow: none;
        }
      }
    }
  }
</style>
