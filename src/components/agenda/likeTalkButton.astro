---
import Star from "../../assets/star.svg";
interface Props {
  sessionId: string | number;
}

const { sessionId } = Astro.props;
---

<button class=`like-btn` data-talk-id={sessionId}>
  <Star />
</button>

<script>
  import { handleToggle, toggleLike } from "../../helpers/agendaHelpers";

  document.addEventListener("DOMContentLoaded", () => {
    const likeBtns = document.querySelectorAll(".like-btn");

    likeBtns.forEach((el) => {
      handleToggle(el);

      el?.addEventListener("click", (e) => {
        e.stopPropagation();

        const talkId = el.getAttribute("data-talk-id");
        toggleLike(talkId || "", el);
      });
    });
  });
</script>

<style lang="scss">
  .like-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    background: none;
    border: none;
    font-size: 20px;
    cursor: pointer;
    color: #ccc;
    transition: all 0.25s ease;
    line-height: 1;
    padding: 0;
    margin: 0;

    &.liked {
      color: var(--yellow);
    }

    &.hidden {
      display: none;
    }

    @media screen and (min-width: 768px) {
      &:hover:not(.liked) {
        color: var(--yellow);
        opacity: 0.4;
      }
    }
  }
</style>
