---
import Star from "../../assets/agenda/star.svg";
interface Props {
  sessionId: string | number;
  sessionTitle: string;
}

const { sessionId, sessionTitle } = Astro.props;
---

<button
  class=`like-btn`
  data-talk-id={sessionId}
  aria-label={`Like ${sessionTitle}`}
  aria-pressed="false"
>
  <Star />
</button>

<script>
  import { handleToggle, toggleLike } from "../../helpers/agenda/agendaHelpers";

  document.addEventListener("DOMContentLoaded", () => {
    const likeBtns = document.querySelectorAll(".like-btn");

    likeBtns.forEach((el) => {
      handleToggle(el);

      el?.addEventListener("click", (e) => {
        e.stopPropagation();

        const talkId = el.getAttribute("data-talk-id");
        toggleLike(talkId || "", el);
      });
    });
  });
</script>

<style lang="scss">
  .like-btn {
    background: none;
    border: none;
    font-size: 20px;
    cursor: pointer;
    color: var(--rs26-muted-3);
    transition: all 0.25s ease;
    line-height: 1;
    padding: 0;
    margin: 0;

    &.liked {
      color: var(--rs26-orange);
    }

    &[disabled] {
      cursor: auto;
      &:not(.hidden) {
        opacity: 0.5;
      }
    }

    @media screen and (min-width: 768px) {
      &:hover:not(.liked):not([disabled]) {
        color: var(--rs26-orange);
        opacity: 0.4;
      }
    }
  }
</style>
