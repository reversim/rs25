---
import type { AgendaSession } from "../../helpers/getAgenda";

interface Props {
  session: AgendaSession;
  desktop: boolean;
}

const { session, desktop } = Astro.props;
---

{
  desktop ? (
    <button
      class="like-btn-desktop"
      data-talk-id={session.id}
      onclick={`event.stopPropagation(); toggleLike('${session.id}')`}
      title="Like this talk"
    >
      ♡
    </button>
  ) : (
    <button
      class="like-btn"
      data-talk-id={session.id}
      onclick={`event.stopPropagation(); toggleLike('${session.id}')`}
      title="Like this talk"
    >
      ♡
    </button>
  )
}

<style lang="scss">
  .like-btn {
    background: none;
    border: none;
    font-size: 18px;
    cursor: pointer;
    color: #ccc;
    transition: color 0.3s ease;
    padding: 0;
    margin: 0;
    line-height: 1;

    &:hover {
      color: var(--pink);
    }

    &.liked {
      color: var(--pink);
    }
  }

  .like-btn-desktop {
    position: absolute;
    top: 10px;
    right: 10px;
    background: none;
    border: none;
    font-size: 16px;
    cursor: pointer;
    color: #ccc;
    transition: color 0.3s ease;

    &:hover {
      color: var(--pink);
    }

    &.liked {
      color: var(--pink);
    }
  }
</style>
