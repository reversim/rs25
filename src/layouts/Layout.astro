---
import Header from "../components/header/header.astro";
import RegistrationBar from "../components/registrationBar.astro";
import { Font } from "astro:assets";
import { getRedirectTarget, isPreview } from "../config/redirects";
import GoogleAnalytics from "../components/shared/googleAnalytics.astro";
import { OG_CARD } from "../helpers/meta";
import "../styles/global.scss";

interface Props {
  havePadding?: boolean;
  havePaddingBottom?: boolean;
  displayHeader?: boolean;
  /**
   * Page-specific link preview. When set, the page is shared under its own
   * URL with this title and description instead of the homepage's, and
   * with `image` (a card from helpers/og/ogCard.ts) when given.
   */
  share?: {
    title: string;
    description: string;
    image?: { path: string; alt: string };
  };
}

const {
  havePadding = true,
  havePaddingBottom = false,
  displayHeader = true,
  share,
} = Astro.props;

// Public URLs have no trailing slash; see `trailingSlash` in astro.config.mjs.
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonicalUrl = new URL(pathname, Astro.site);
const isNotFound = pathname === "/404";
const redirectTarget = getRedirectTarget(pathname);
const isBlocked = redirectTarget !== undefined;
// Redirect stubs aren't real page views, and dev/preview traffic stays out of GA.
const loadAnalytics = import.meta.env.PROD && !isPreview && !isBlocked;

const description =
  "Reversim Summit 2026 is Israel’s leading community-driven tech conference, bringing together developers, product managers, and data scientists for top-tier content and networking.";
const ogImage = share?.image
  ? {
      url: new URL(share.image.path, Astro.site),
      alt: share.image.alt,
      ...OG_CARD,
    }
  : {
      url: new URL("/og-image-2026.png", Astro.site),
      alt: "Reversim Summit 2026, 30.11-1.12, 2026",
      width: 1200,
      height: 600,
    };
const ogTitle = share?.title ?? "Reversim 2026";
const ogDescription = share?.description ?? description;
const ogUrl = share ? canonicalUrl : "https://summit2026.reversim.com/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-dark-mode.png" />
    <link
      rel="icon"
      type="image/png"
      href="/favicon-light-mode.png"
      media="(prefers-color-scheme: light)"
    />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Font cssVariable="--font-space-grotesk" preload />
    <Font cssVariable="--font-hanken-grotesk" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    <meta name="generator" content={Astro.generator} />
    <title>Reversim 2026</title>
    <meta name="description" content={description} />

    {!isBlocked && !isNotFound && <link rel="canonical" href={canonicalUrl} />}
    <!--
      Browsers that cached the old `/page` -> `/page/` 301 land on the slash
      form, which Firebase serves as-is. Tidy the address bar without a
      redirect; an HTTP redirect here would loop.
    -->
    <script is:inline>
      if (/.\/$/.test(location.pathname)) {
        history.replaceState(
          history.state,
          "",
          location.pathname.replace(/\/+$/, "") +
            location.search +
            location.hash,
        );
      }
    </script>

    {isPreview && <meta name="robots" content="noindex, nofollow" />}

    {
      isBlocked && (
        <>
          <meta name="robots" content="noindex" />
          <meta http-equiv="refresh" content={`0;url=${redirectTarget}`} />
          <script is:inline define:vars={{ redirectTarget }}>
            window.location.replace(redirectTarget);
          </script>
        </>
      )
    }

    <meta property="og:title" content={ogTitle} />
    <meta property="og:site_name" content="Reversim Summit 2026" />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage.url} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={ogImage.alt} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage.url} />
    <meta name="twitter:image:alt" content={ogImage.alt} />

    {loadAnalytics && <GoogleAnalytics />}
    <script>
      import { initAnalytics } from "../helpers/analytics";
      initAnalytics();
    </script>
  </head>
  <body>
    {!isBlocked && displayHeader && <RegistrationBar />}
    {!isBlocked && displayHeader && <Header />}
    {
      !isBlocked && (
        <div
          class={`body-container ${havePadding ? "have-padding" : ""} ${havePaddingBottom ? "have-padding-bottom" : ""}`}
        >
          <slot class="layout-container" />
        </div>
      )
    }
  </body>
</html>
